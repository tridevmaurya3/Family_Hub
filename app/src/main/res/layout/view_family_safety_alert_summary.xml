<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="0dp"
    android:layout_height="72dp"
    android:layout_marginEnd="4dp"
    android:layout_weight="1"
    app:cardBackgroundColor="@color/fh_surface"
    app:cardCornerRadius="@dimen/radius_14"
    app:strokeColor="@color/fh_outline_variant"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="4dp">

        <TextView
            android:id="@+id/textSummaryValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/fh_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textSummaryLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/fh_text_secondary"
            android:textSize="9sp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
