<?xml version='1.0' encoding='UTF-8'?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_form_floating_shell"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingTop="6dp"
        android:paddingEnd="8dp"
        android:paddingBottom="10dp">
        <com.google.android.material.card.MaterialCardView
            android:layout_width="36dp"
            android:layout_height="3dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="6dp"
            app:cardBackgroundColor="@color/fh_outline_variant"
            app:cardCornerRadius="2dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"/>
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.FamilyHub.Form.Header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/fh_module_reminders_container"
            app:strokeColor="@color/fh_module_reminders"
            app:cardCornerRadius="12dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="8dp">
                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_placeholder_icon"
                    android:contentDescription="@null"
                    android:padding="7dp"
                    android:src="@drawable/ic_reminder"
                    app:tint="@color/fh_module_reminders"/>
                <TextView
                    android:id="@+id/reminder_editor_title"
                    style="@style/TextAppearance.FamilyHub.SectionTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_12"
                    android:layout_weight="1"
                    android:textColor="@color/fh_on_warning_container"
                    android:textSize="15sp"
                    android:maxLines="1"
                    android:ellipsize="end"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.FamilyHub.Form.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:cardCornerRadius="12dp"
            app:cardBackgroundColor="@color/fh_primary_container"
            app:strokeColor="@color/fh_primary">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="7dp">
                <TextView
                    style="@style/TextAppearance.FamilyHub.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="@string/form_section_details"
                    android:textColor="@color/fh_primary"
                    android:textSize="11sp"
                    android:textStyle="bold"/>
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/reminder_title_layout"
                    style="@style/Widget.FamilyHub.FloatingCompact.Field"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:hint="@string/reminder_title">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/reminder_title_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapSentences"
                        android:maxLines="1"/>
                </com.google.android.material.textfield.TextInputLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:orientation="horizontal">
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.FamilyHub.FloatingCompact.Dropdown"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_4"
                        android:layout_weight="1"
                        android:hint="Priority"
                        app:endIconMode="dropdown_menu">
                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/reminder_priority_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"/>
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.FamilyHub.FloatingCompact.Dropdown"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_4"
                        android:layout_weight="1"
                        android:hint="Category"
                        app:endIconMode="dropdown_menu">
                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/reminder_category_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"/>
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.FamilyHub.FloatingCompact.Dropdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:hint="Assign family member"
                    app:endIconMode="dropdown_menu">
                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/reminder_assignee_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"/>
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.FamilyHub.Form.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:cardCornerRadius="12dp"
            app:cardBackgroundColor="@color/fh_primary_container"
            app:strokeColor="@color/fh_primary">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="7dp">
                <TextView
                    style="@style/TextAppearance.FamilyHub.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="@string/form_section_options"
                    android:textColor="@color/fh_primary"
                    android:textSize="11sp"
                    android:textStyle="bold"/>
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.FamilyHub.FloatingCompact.Dropdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:hint="Connect with module"
                    app:endIconMode="dropdown_menu">
                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/reminder_related_module_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"/>
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.FamilyHub.FloatingCompact.Field"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:hint="Related bill, item, appointment or task">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/reminder_related_item_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapSentences"
                        android:maxLines="2"/>
                </com.google.android.material.textfield.TextInputLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="5dp">
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/reminder_date_layout"
                        style="@style/Widget.FamilyHub.FloatingCompact.Field"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="0dp"
                        android:hint="@string/reminder_date"
                        app:endIconDrawable="@drawable/ic_reminder"
                        app:endIconMode="custom"
                        app:endIconTint="@color/fh_module_reminders"
                        android:layout_weight="1"
                        android:layout_marginEnd="3dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/reminder_date_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clickable="true"
                            android:focusable="false"
                            android:inputType="none"
                            android:maxLines="1"/>
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/reminder_time_layout"
                        style="@style/Widget.FamilyHub.FloatingCompact.Field"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="0dp"
                        android:hint="@string/reminder_time"
                        app:endIconDrawable="@drawable/ic_reminder"
                        app:endIconMode="custom"
                        app:endIconTint="@color/fh_module_reminders"
                        android:layout_weight="1"
                        android:layout_marginStart="3dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/reminder_time_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clickable="true"
                            android:focusable="false"
                            android:inputType="none"
                            android:maxLines="1"/>
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.FamilyHub.Form.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:cardCornerRadius="12dp"
            app:cardBackgroundColor="@color/fh_primary_container"
            app:strokeColor="@color/fh_primary">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="7dp">
                <TextView
                    style="@style/TextAppearance.FamilyHub.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="@string/form_section_more"
                    android:textColor="@color/fh_primary"
                    android:textSize="11sp"
                    android:textStyle="bold"/>
                <TextView
                    style="@style/TextAppearance.FamilyHub.Overline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/reminder_repeat"
                    android:textColor="@color/fh_module_reminders"/>
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.FamilyHub.Card.Subtle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp">
                    <RadioGroup
                        android:id="@+id/reminder_repeat_group"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/space_10"
                        android:paddingEnd="@dimen/space_10">
                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/repeat_once_button"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/touch_target_min"
                            android:layout_weight="1"
                            android:checked="true"
                            android:text="@string/reminder_once"
                            android:textColor="@color/fh_on_surface"/>
                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/repeat_daily_button"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/touch_target_min"
                            android:layout_weight="1"
                            android:text="@string/reminder_daily"
                            android:textColor="@color/fh_on_surface"/>
                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/repeat_weekly_button"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/touch_target_min"
                            android:layout_weight="1"
                            android:text="Weekly"
                            android:textColor="@color/fh_on_surface"/>
                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/repeat_monthly_button"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/touch_target_min"
                            android:layout_weight="1"
                            android:text="Monthly"
                            android:textColor="@color/fh_on_surface"/>
                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/repeat_yearly_button"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/touch_target_min"
                            android:layout_weight="1"
                            android:text="Yearly"
                            android:textColor="@color/fh_on_surface"/>
                    </RadioGroup>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.FamilyHub.FloatingCompact.Dropdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:hint="Notify me before"
                    app:endIconMode="dropdown_menu">
                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/reminder_pre_alert_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"/>
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.FamilyHub.Card.Subtle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp">
                    <com.google.android.material.materialswitch.MaterialSwitch
                        style="@style/Widget.FamilyHub.FloatingCompact.Switch"
                        android:id="@+id/reminder_enabled_switch"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/input_min_height"
                        android:checked="true"
                        android:paddingStart="@dimen/space_12"
                        android:paddingEnd="@dimen/space_12"
                        android:text="@string/reminder_enabled"
                        android:textColor="@color/fh_on_surface"/>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/reminder_note_layout"
                    style="@style/Widget.FamilyHub.FloatingCompact.Field"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:hint="@string/reminder_note">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/reminder_note_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top|start"
                        android:inputType="textMultiLine|textCapSentences"
                        android:maxLines="4"
                        android:minLines="3"/>
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.FamilyHub.Form.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:cardCornerRadius="12dp"
            app:cardBackgroundColor="@color/fh_primary_container"
            app:strokeColor="@color/fh_primary">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="7dp">
                <TextView
                    style="@style/TextAppearance.FamilyHub.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="@string/form_section_collaboration"
                    android:textColor="@color/fh_primary"
                    android:textSize="11sp"
                    android:textStyle="bold"/>
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.FamilyHub.FloatingCompact.Dropdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:hint="@string/collaboration_status"
                    app:endIconMode="dropdown_menu">
                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/reminder_collaboration_status_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"/>
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                    style="@style/Widget.FamilyHub.FloatingCompact.Switch"
                    android:id="@+id/reminder_shared_switch"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/touch_target_min"
                    android:text="@string/share_with_family"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/cancel_reminder_button"
                style="@style/Widget.FamilyHub.Form.CompactCancel"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="@dimen/space_4"
                android:layout_weight="1"
                android:text="@string/cancel"
                android:minHeight="40dp"
                android:textSize="11.5sp"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/save_reminder_button"
                style="@style/Widget.FamilyHub.FloatingCompact.PrimaryAction"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="@dimen/space_4"
                android:layout_weight="1"
                android:text="@string/save_reminder"
                android:minHeight="40dp"/>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>