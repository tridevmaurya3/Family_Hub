<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/family_map_info_width"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_family_map_info_window"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textMapInfoName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/family_map_info_value"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textMapInfoRole"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/family_map_info_label"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/textMapInfoStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_family_map_status_chip"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/family_map_live"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="8dp"
        android:background="@color/family_map_info_border" />

    <TextView
        android:id="@+id/textMapInfoPlace"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/family_map_info_value"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textMapInfoUpdated"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/family_map_info_row_spacing"
        android:maxLines="1"
        android:textColor="@color/family_map_info_label"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/textMapInfoAccuracy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/family_map_info_row_spacing"
        android:maxLines="1"
        android:textColor="@color/family_map_info_label"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/textMapInfoBattery"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/family_map_info_row_spacing"
        android:maxLines="1"
        android:textColor="@color/family_map_info_label"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/textMapInfoNetwork"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/family_map_info_row_spacing"
        android:maxLines="1"
        android:textColor="@color/family_map_info_label"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/textMapInfoMovement"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/family_map_info_row_spacing"
        android:maxLines="1"
        android:textColor="@color/family_map_info_label"
        android:textSize="12sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="@string/family_map_info_live_hint"
        android:textColor="@color/fh_primary"
        android:textSize="11sp"
        android:textStyle="bold" />

</LinearLayout>
