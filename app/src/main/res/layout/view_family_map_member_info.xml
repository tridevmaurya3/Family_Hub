<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/family_map_info_width"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_family_map_info_window"
    android:orientation="vertical">

    <TextView
        android:id="@+id/textMapInfoName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/family_map_info_value"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textMapInfoRole"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/family_map_info_label"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/textMapInfoStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_family_map_status_chip"
        android:gravity="center"
        android:maxLines="1"
        android:paddingStart="8dp"
        android:paddingTop="3dp"
        android:paddingEnd="8dp"
        android:paddingBottom="3dp"
        android:textColor="@color/family_map_live"
        android:textSize="9sp"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="7dp"
        android:layout_marginBottom="6dp"
        android:background="@color/family_map_info_border" />

    <TextView
        android:id="@+id/textMapInfoPlace"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="3"
        android:textColor="@color/family_map_info_value"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textMapInfoUpdated"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/family_map_info_row_spacing"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/family_map_info_label"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/textMapInfoAccuracy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/family_map_info_row_spacing"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/family_map_info_label"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/textMapInfoBattery"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/family_map_info_row_spacing"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/family_map_info_label"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/textMapInfoNetwork"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/family_map_info_row_spacing"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/family_map_info_label"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/textMapInfoMovement"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/family_map_info_row_spacing"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/family_map_info_label"
        android:textSize="10sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:gravity="center"
        android:text="@string/family_map_info_live_hint"
        android:textColor="@color/fh_primary"
        android:textSize="9sp"
        android:textStyle="bold" />

</LinearLayout>
