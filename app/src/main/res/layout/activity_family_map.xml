<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/familyMapRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@drawable/bg_page_three_tone">

    <FrameLayout
        android:id="@+id/familyMapHost"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/familyMapTopPanel"
        style="@style/Widget.FamilyHub.Card.Flat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="18dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="18dp"
        android:elevation="@dimen/family_map_panel_elevation"
        app:cardBackgroundColor="@color/family_map_panel_surface"
        app:cardCornerRadius="18dp"
        app:strokeColor="@color/family_map_panel_stroke"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingTop="7dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonFamilyMapBack"
                    style="@style/Widget.FamilyHub.Button.Tonal"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:contentDescription="@string/family_map_back_description"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    android:text=""
                    app:icon="@drawable/ic_arrow_back"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="20dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextAppearance.FamilyHub.SectionTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="@string/family_map_title"
                        android:textSize="19sp" />

                    <TextView
                        style="@style/TextAppearance.FamilyHub.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="@string/family_map_advanced_subtitle"
                        android:textColor="@color/fh_text_secondary"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonFamilyMapRetry"
                    style="@style/Widget.FamilyHub.Button.Tonal"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:contentDescription="@string/family_map_refresh_description"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    android:text=""
                    app:icon="@drawable/ic_family_map_refresh"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="20dp"
                    app:iconTint="@color/fh_primary" />
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.FamilyHub.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:boxCornerRadiusBottomEnd="14dp"
                app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusTopEnd="14dp"
                app:boxCornerRadiusTopStart="14dp"
                app:endIconMode="clear_text"
                app:hintEnabled="false"
                app:startIconDrawable="@drawable/ic_search">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputFamilyMapSearch"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:gravity="center_vertical"
                    android:hint="@string/family_live_search_hint"
                    android:imeOptions="actionSearch"
                    android:includeFontPadding="false"
                    android:inputType="text"
                    android:maxLines="1"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.tridev.familyhub.feature.familylive.FamilyMapComparePanelView
        android:id="@+id/familyMapComparePanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="@dimen/space_12"
        android:layout_marginEnd="@dimen/space_12"
        android:elevation="@dimen/family_map_panel_elevation"
        android:visibility="gone" />

    <View
        android:id="@+id/familyMapControlRail"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="@dimen/space_12"
        android:layout_marginBottom="@dimen/space_12" />

    <com.tridev.familyhub.feature.familylive.FamilyMapExpandableControlsView
        android:id="@+id/familyMapExpandableControls"
        android:layout_width="@dimen/family_map_controls_collapsed_width"
        android:layout_height="@dimen/family_map_controls_height"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="@dimen/space_12"
        android:layout_marginBottom="@dimen/space_12"
        android:elevation="@dimen/family_map_panel_elevation"
        app:cardBackgroundColor="@color/family_map_panel_surface"
        app:cardCornerRadius="@dimen/radius_18"
        app:strokeColor="@color/family_map_panel_stroke"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical|start"
            android:orientation="horizontal"
            android:padding="4dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonFamilyMapMenu"
                style="@style/Widget.FamilyHub.Button.Tonal"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="4dp"
                android:contentDescription="@string/family_map_menu_expand_description"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:text=""
                app:backgroundTint="@color/fh_primary_container"
                app:icon="@drawable/ic_family_map_menu"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="22dp"
                app:iconTint="@color/fh_primary" />

            <LinearLayout
                android:id="@+id/familyMapActionsContainer"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonFamilyMapFit"
                    style="@style/Widget.FamilyHub.Button.Tonal"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="@string/family_map_all_members_description"
                    android:ellipsize="none"
                    android:gravity="center"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:maxLines="1"
                    android:minWidth="0dp"
                    android:paddingStart="1dp"
                    android:paddingEnd="1dp"
                    android:text="@string/family_map_control_all_short"
                    android:textColor="@color/fh_module_family"
                    android:textSize="7sp"
                    app:backgroundTint="@color/fh_module_family_container"
                    app:icon="@drawable/ic_family_map_group"
                    app:iconGravity="textStart"
                    app:iconPadding="1dp"
                    app:iconSize="14dp"
                    app:iconTint="@color/fh_module_family" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonFamilyMapRecenter"
                    style="@style/Widget.FamilyHub.Button.Tonal"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="2dp"
                    android:layout_weight="1"
                    android:contentDescription="@string/family_map_recenter_description"
                    android:ellipsize="none"
                    android:gravity="center"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:maxLines="1"
                    android:minWidth="0dp"
                    android:paddingStart="1dp"
                    android:paddingEnd="1dp"
                    android:text="@string/family_map_control_me_short"
                    android:textColor="@color/fh_secondary"
                    android:textSize="7sp"
                    app:backgroundTint="@color/fh_secondary_container"
                    app:icon="@drawable/ic_family_map_recenter"
                    app:iconGravity="textStart"
                    app:iconPadding="1dp"
                    app:iconSize="14dp"
                    app:iconTint="@color/fh_secondary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonFamilyMapType"
                    style="@style/Widget.FamilyHub.Button.Tonal"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="2dp"
                    android:layout_weight="1"
                    android:contentDescription="@string/family_map_type_description"
                    android:ellipsize="none"
                    android:gravity="center"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:maxLines="1"
                    android:minWidth="0dp"
                    android:paddingStart="1dp"
                    android:paddingEnd="1dp"
                    android:text="@string/family_map_control_normal_short"
                    android:textColor="@color/fh_module_documents"
                    android:textSize="7sp"
                    app:backgroundTint="@color/fh_module_documents_container"
                    app:icon="@drawable/ic_family_map_layers"
                    app:iconGravity="textStart"
                    app:iconPadding="1dp"
                    app:iconSize="14dp"
                    app:iconTint="@color/fh_module_documents" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonFamilyMapTraffic"
                    style="@style/Widget.FamilyHub.Button.Tonal"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="2dp"
                    android:layout_weight="1"
                    android:checkable="true"
                    android:contentDescription="@string/family_map_traffic_description"
                    android:ellipsize="none"
                    android:gravity="center"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:maxLines="1"
                    android:minWidth="0dp"
                    android:paddingStart="1dp"
                    android:paddingEnd="1dp"
                    android:text="@string/family_map_control_traffic_short"
                    android:textColor="@color/fh_module_planner"
                    android:textSize="7sp"
                    app:backgroundTint="@color/fh_module_planner_container"
                    app:icon="@drawable/ic_family_map_traffic"
                    app:iconGravity="textStart"
                    app:iconPadding="1dp"
                    app:iconSize="14dp"
                    app:iconTint="@color/fh_module_planner" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonFamilyMapStreetView"
                    style="@style/Widget.FamilyHub.Button.Tonal"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="2dp"
                    android:layout_weight="1"
                    android:contentDescription="@string/family_map_street_view_description"
                    android:ellipsize="none"
                    android:gravity="center"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:maxLines="1"
                    android:minWidth="0dp"
                    android:paddingStart="1dp"
                    android:paddingEnd="1dp"
                    android:text="@string/family_map_control_street_view_short"
                    android:textColor="@color/fh_primary"
                    android:textSize="7sp"
                    app:backgroundTint="@color/fh_primary_container"
                    app:icon="@drawable/ic_family_map_street_view"
                    app:iconGravity="textStart"
                    app:iconPadding="1dp"
                    app:iconSize="14dp"
                    app:iconTint="@color/fh_primary" />
            </LinearLayout>
        </LinearLayout>
    </com.tridev.familyhub.feature.familylive.FamilyMapExpandableControlsView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/familyMapBottomPanel"
        style="@style/Widget.FamilyHub.Card.Flat"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/family_map_legend_height"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/space_12"
        android:layout_marginBottom="@dimen/space_12"
        android:elevation="@dimen/family_map_panel_elevation"
        app:cardBackgroundColor="@color/family_map_panel_surface"
        app:cardCornerRadius="@dimen/radius_18"
        app:strokeColor="@color/family_map_panel_stroke"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_12"
            android:paddingEnd="@dimen/space_12">

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_family_map_dot_live" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="@string/family_map_legend_live"
                android:textColor="@color/fh_text_secondary"
                android:textSize="11sp" />

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="@dimen/space_12"
                android:background="@drawable/bg_family_map_dot_stale" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="@string/family_map_legend_stale"
                android:textColor="@color/fh_text_secondary"
                android:textSize="11sp" />

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="@dimen/space_12"
                android:background="@drawable/bg_family_map_dot_safe" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="@string/family_map_legend_safe_place"
                android:textColor="@color/fh_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <ProgressBar
        android:id="@+id/familyMapLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:contentDescription="@string/family_live_map_loading" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/familyMapStateCard"
        style="@style/Widget.FamilyHub.Card.Flat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="@dimen/space_24"
        android:visibility="gone"
        app:cardBackgroundColor="@color/family_map_panel_surface"
        app:cardCornerRadius="@dimen/radius_16"
        app:strokeColor="@color/family_map_panel_stroke"
        app:strokeWidth="1dp">

        <TextView
            android:id="@+id/textFamilyMapState"
            style="@style/TextAppearance.FamilyHub.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="@dimen/card_padding"
            android:textAlignment="center" />
    </com.google.android.material.card.MaterialCardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
