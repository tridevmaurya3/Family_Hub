<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/familyMapRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true"
    android:background="@color/fh_background">

    <FrameLayout
        android:id="@+id/familyMapHost"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/familyMapTopPanel"
        style="@style/Widget.FamilyHub.Card.Flat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="@dimen/space_12"
        android:layout_marginTop="@dimen/space_8"
        android:layout_marginEnd="@dimen/space_12"
        android:elevation="@dimen/family_map_panel_elevation"
        app:cardBackgroundColor="@color/family_map_panel_surface"
        app:cardCornerRadius="@dimen/radius_20"
        app:strokeColor="@color/family_map_panel_stroke"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_10">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonFamilyMapBack"
                    style="@style/Widget.FamilyHub.Button.Tonal"
                    android:layout_width="@dimen/touch_target_min"
                    android:layout_height="@dimen/touch_target_min"
                    android:contentDescription="@string/family_map_back_description"
                    android:minWidth="0dp"
                    android:text=""
                    app:icon="@drawable/ic_arrow_back"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_12"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextAppearance.FamilyHub.SectionTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/family_map_title" />

                    <TextView
                        style="@style/TextAppearance.FamilyHub.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/family_map_advanced_subtitle"
                        android:textColor="@color/fh_text_secondary" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonFamilyMapRetry"
                    style="@style/Widget.FamilyHub.Button.Tonal"
                    android:layout_width="@dimen/touch_target_min"
                    android:layout_height="@dimen/touch_target_min"
                    android:contentDescription="@string/family_map_refresh_description"
                    android:minWidth="0dp"
                    android:text=""
                    app:icon="@drawable/ic_family_map_refresh"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconTint="@color/fh_primary" />
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.FamilyHub.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:hint="@string/family_live_search_hint"
                app:endIconMode="clear_text"
                app:startIconDrawable="@drawable/ic_search">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputFamilyMapSearch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/familyMapControlRail"
        style="@style/Widget.FamilyHub.Card.Flat"
        android:layout_width="@dimen/family_map_advanced_control_width"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="@dimen/space_12"
        android:elevation="@dimen/family_map_panel_elevation"
        app:cardBackgroundColor="@color/family_map_panel_surface"
        app:cardCornerRadius="@dimen/radius_18"
        app:strokeColor="@color/family_map_panel_stroke"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_6">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonFamilyMapFit"
                style="@style/Widget.FamilyHub.Button.Tonal"
                android:layout_width="match_parent"
                android:layout_height="@dimen/family_map_advanced_control_button_height"
                android:contentDescription="@string/family_map_all_members_description"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:maxLines="1"
                android:minWidth="0dp"
                android:text="@string/family_map_control_all_short"
                android:textColor="@color/fh_module_family"
                android:textSize="10sp"
                app:backgroundTint="@color/fh_module_family_container"
                app:icon="@drawable/ic_family_map_group"
                app:iconGravity="textTop"
                app:iconPadding="2dp"
                app:iconSize="20dp"
                app:iconTint="@color/fh_module_family" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonFamilyMapRecenter"
                style="@style/Widget.FamilyHub.Button.Tonal"
                android:layout_width="match_parent"
                android:layout_height="@dimen/family_map_advanced_control_button_height"
                android:layout_marginTop="@dimen/space_6"
                android:contentDescription="@string/family_map_recenter_description"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:maxLines="1"
                android:minWidth="0dp"
                android:text="@string/family_map_control_me_short"
                android:textColor="@color/fh_secondary"
                android:textSize="10sp"
                app:backgroundTint="@color/fh_secondary_container"
                app:icon="@drawable/ic_family_map_recenter"
                app:iconGravity="textTop"
                app:iconPadding="2dp"
                app:iconSize="20dp"
                app:iconTint="@color/fh_secondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonFamilyMapType"
                style="@style/Widget.FamilyHub.Button.Tonal"
                android:layout_width="match_parent"
                android:layout_height="@dimen/family_map_advanced_control_button_height"
                android:layout_marginTop="@dimen/space_6"
                android:contentDescription="@string/family_map_type_description"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:maxLines="1"
                android:minWidth="0dp"
                android:text="@string/family_map_control_normal_short"
                android:textColor="@color/fh_module_documents"
                android:textSize="10sp"
                app:backgroundTint="@color/fh_module_documents_container"
                app:icon="@drawable/ic_family_map_layers"
                app:iconGravity="textTop"
                app:iconPadding="2dp"
                app:iconSize="20dp"
                app:iconTint="@color/fh_module_documents" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonFamilyMapTraffic"
                style="@style/Widget.FamilyHub.Button.Tonal"
                android:layout_width="match_parent"
                android:layout_height="@dimen/family_map_advanced_control_button_height"
                android:layout_marginTop="@dimen/space_6"
                android:checkable="true"
                android:contentDescription="@string/family_map_traffic_description"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:maxLines="1"
                android:minWidth="0dp"
                android:text="@string/family_map_control_traffic_short"
                android:textColor="@color/fh_module_planner"
                android:textSize="10sp"
                app:backgroundTint="@color/fh_module_planner_container"
                app:icon="@drawable/ic_family_map_traffic"
                app:iconGravity="textTop"
                app:iconPadding="2dp"
                app:iconSize="20dp"
                app:iconTint="@color/fh_module_planner" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/familyMapBottomPanel"
        style="@style/Widget.FamilyHub.Card.Flat"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/family_map_legend_height"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="@dimen/space_12"
        android:layout_marginBottom="@dimen/space_12"
        android:elevation="@dimen/family_map_panel_elevation"
        app:cardBackgroundColor="@color/family_map_panel_surface"
        app:cardCornerRadius="@dimen/radius_18"
        app:strokeColor="@color/family_map_panel_stroke"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_12"
            android:paddingEnd="@dimen/space_12">

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_family_map_dot_live" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="@string/family_map_legend_live"
                android:textColor="@color/fh_text_secondary"
                android:textSize="11sp" />

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="@dimen/space_12"
                android:background="@drawable/bg_family_map_dot_stale" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="@string/family_map_legend_stale"
                android:textColor="@color/fh_text_secondary"
                android:textSize="11sp" />

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="@dimen/space_12"
                android:background="@drawable/bg_family_map_dot_safe" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="@string/family_map_legend_safe_place"
                android:textColor="@color/fh_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <ProgressBar
        android:id="@+id/familyMapLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:contentDescription="@string/family_live_map_loading" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/familyMapStateCard"
        style="@style/Widget.FamilyHub.Card.Flat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="@dimen/space_24"
        android:visibility="gone"
        app:cardBackgroundColor="@color/family_map_panel_surface"
        app:cardCornerRadius="@dimen/radius_16"
        app:strokeColor="@color/family_map_panel_stroke"
        app:strokeWidth="1dp">

        <TextView
            android:id="@+id/textFamilyMapState"
            style="@style/TextAppearance.FamilyHub.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="@dimen/card_padding"
            android:textAlignment="center" />
    </com.google.android.material.card.MaterialCardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
