<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@drawable/bg_page_three_tone"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding_horizontal"
        android:paddingTop="@dimen/space_16"
        android:paddingEnd="@dimen/screen_padding_horizontal"
        android:paddingBottom="@dimen/space_32">

        <com.google.android.material.card.MaterialCardView style="@style/Widget.FamilyHub.Card.Flat"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/fh_surface" app:strokeColor="@color/fh_outline_variant">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center_vertical" android:orientation="horizontal" android:padding="@dimen/space_8">
                <ImageButton android:id="@+id/button_back" android:layout_width="36dp" android:layout_height="36dp"
                    android:background="@drawable/bg_icon_button" android:contentDescription="@string/action_back"
                    android:padding="9dp" android:src="@drawable/ic_arrow_back" app:tint="@color/fh_primary" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_8" android:layout_weight="1" android:orientation="vertical">
                    <TextView style="@style/TextAppearance.FamilyHub.Heading" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:text="@string/family_admin_title" android:textSize="16sp" />
                    <TextView android:id="@+id/tv_family_name" style="@style/TextAppearance.FamilyHub.Caption"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/family_account_title" android:textSize="10sp" />
                </LinearLayout>
                <ImageButton android:id="@+id/button_notifications" android:layout_width="36dp" android:layout_height="36dp"
                    android:background="@drawable/bg_icon_button" android:contentDescription="@string/reminders_title"
                    android:padding="9dp" android:src="@drawable/ic_bell" app:tint="@color/fh_primary" />
                <ImageButton android:id="@+id/button_profile" android:layout_width="36dp" android:layout_height="36dp"
                    android:layout_marginStart="@dimen/space_4" android:background="@drawable/bg_icon_button"
                    android:contentDescription="@string/more_profile_title" android:padding="9dp"
                    android:src="@drawable/ic_profile_person" app:tint="@color/fh_primary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/TextAppearance.FamilyHub.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:text="@string/family_admin_flow_explanation"
            android:textColor="@color/fh_text_secondary" />

        <ProgressBar
            android:id="@+id/progress_family_admin"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_12"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_admin_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:textColor="@color/fh_error"
            android:textSize="12sp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_generate_invite"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/space_16"
            android:text="@string/family_admin_generate_invite"
            app:cornerRadius="@dimen/radius_12" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_manage_households"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/space_8"
            android:text="@string/household_manage"
            app:cornerRadius="@dimen/radius_12" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_refresh_family"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/space_8"
            android:text="@string/family_account_refresh"
            app:cornerRadius="@dimen/radius_12" />

        <TextView
            style="@style/TextAppearance.FamilyHub.Overline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            android:text="@string/family_admin_pending_requests"
            android:textColor="@color/fh_primary" />

        <TextView
            android:id="@+id/tv_pending_empty"
            style="@style/TextAppearance.FamilyHub.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:text="@string/family_admin_no_pending" />

        <LinearLayout
            android:id="@+id/pending_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            style="@style/TextAppearance.FamilyHub.Overline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            android:text="@string/family_admin_members"
            android:textColor="@color/fh_primary" />

        <LinearLayout
            android:id="@+id/member_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
