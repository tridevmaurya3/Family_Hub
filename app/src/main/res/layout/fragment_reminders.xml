<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:background="@drawable/bg_page_three_tone" android:padding="@dimen/space_8">
    <com.tridev.familyhub.core.ui.cards.ModuleOverviewView android:id="@+id/reminders_overview"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        app:overviewAccentColor="@color/fh_module_reminders" app:overviewContainerColor="@color/fh_module_reminders_container"
        app:overviewDetail="@string/reminders_subtitle" app:overviewIcon="@drawable/ic_reminder" app:overviewTitle="@string/reminders_title" />
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:fillViewport="true" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="80dp">
        <com.tridev.familyhub.feature.reminders.ReminderDashboardSummaryView android:id="@+id/reminder_dashboard_summary"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" />
        <HorizontalScrollView android:id="@+id/reminder_filter_scroll" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:scrollbars="none" android:layout_marginTop="@dimen/space_4">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton android:id="@+id/reminder_status_filter"
                style="@style/Widget.FamilyHub.Button.Outlined" android:layout_width="wrap_content" android:layout_height="48dp"
                android:layout_marginEnd="4dp" android:minWidth="0dp" android:textSize="11sp" android:text="Active ▾" />
            <com.google.android.material.button.MaterialButton android:id="@+id/reminder_period_filter"
                style="@style/Widget.FamilyHub.Button.Outlined" android:layout_width="wrap_content" android:layout_height="48dp"
                android:layout_marginEnd="4dp" android:minWidth="0dp" android:textSize="11sp" android:text="All dates ▾" />
            <com.google.android.material.button.MaterialButton android:id="@+id/reminder_category_filter"
                style="@style/Widget.FamilyHub.Button.Outlined" android:layout_width="wrap_content" android:layout_height="48dp"
                android:layout_marginEnd="4dp" android:minWidth="0dp" android:textSize="11sp" android:text="Category ▾" />
            <com.google.android.material.button.MaterialButton android:id="@+id/reminder_priority_filter"
                style="@style/Widget.FamilyHub.Button.Outlined" android:layout_width="wrap_content" android:layout_height="48dp"
                android:layout_marginEnd="4dp" android:minWidth="0dp" android:textSize="11sp" android:text="Priority ▾" />
            <com.google.android.material.button.MaterialButton android:id="@+id/reminder_member_filter"
                style="@style/Widget.FamilyHub.Button.Outlined" android:layout_width="wrap_content" android:layout_height="48dp"
                android:layout_marginEnd="4dp" android:minWidth="0dp" android:textSize="11sp" android:text="Member ▾" />
            <com.google.android.material.button.MaterialButton android:id="@+id/reminder_sort_filter"
                style="@style/Widget.FamilyHub.Button.Outlined" android:layout_width="wrap_content" android:layout_height="48dp"
                android:layout_marginEnd="4dp" android:minWidth="0dp" android:textSize="11sp" android:text="Due ▾" />
            <com.google.android.material.button.MaterialButton android:id="@+id/reminder_report_button"
                style="@style/Widget.FamilyHub.Button.Outlined" android:layout_width="wrap_content" android:layout_height="48dp"
                android:minWidth="0dp" android:text="Report ▾" />
        </LinearLayout></HorizontalScrollView>
        <com.google.android.material.textfield.TextInputLayout android:id="@+id/reminder_search_layout"
            style="@style/Widget.FamilyHub.TextInputLayout" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="@string/search_reminders" app:startIconDrawable="@drawable/ic_search" app:startIconTint="@color/fh_module_reminders">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/reminder_search_input"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>
        <FrameLayout android:id="@+id/reminder_quick_host" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" />
        <TextView android:id="@+id/reminder_results" style="@style/TextAppearance.FamilyHub.Caption"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="6dp" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/reminder_recycler_view"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:nestedScrollingEnabled="false" />
        <LinearLayout android:id="@+id/reminders_empty_state" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center" android:padding="12dp" android:visibility="gone">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/no_reminders_title" />
            <com.google.android.material.button.MaterialButton android:id="@+id/empty_add_reminder_button"
                android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/add_reminder_short" />
        </LinearLayout>
    </LinearLayout></androidx.core.widget.NestedScrollView>
</LinearLayout>
