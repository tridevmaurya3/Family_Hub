<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_page_three_tone"
    android:paddingStart="@dimen/screen_padding_horizontal"
    android:paddingTop="@dimen/compact_page_top_padding"
    android:paddingEnd="@dimen/screen_padding_horizontal">

    <com.tridev.familyhub.core.ui.cards.ModuleOverviewView
        android:id="@+id/reminders_overview"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:overviewAccentColor="@color/fh_module_reminders"
        app:overviewContainerColor="@color/fh_module_reminders_container"
        app:overviewDetail="@string/reminders_subtitle"
        app:overviewIcon="@drawable/ic_reminder"
        app:overviewTitle="@string/reminders_title" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/reminder_search_layout"
        style="@style/Widget.FamilyHub.TextInputLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/compact_section_spacing"
        android:hint="@string/search_reminders"
        app:endIconMode="clear_text"
        app:startIconDrawable="@drawable/ic_search"
        app:startIconTint="@color/fh_module_reminders"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/reminder_dashboard_summary">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/reminder_search_input"
            style="@style/TextAppearance.FamilyHub.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/fh_on_surface" />

    </com.google.android.material.textfield.TextInputLayout>

    <HorizontalScrollView
        android:id="@+id/reminder_filter_scroll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:clipToPadding="false"
        android:fillViewport="false"
        android:scrollbars="none"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/reminder_search_layout">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/reminder_period_filter"
                style="@style/Widget.FamilyHub.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_target_min"
                android:minWidth="0dp"
                android:text="All dates ▾" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/reminder_priority_filter"
                style="@style/Widget.FamilyHub.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_target_min"
                android:layout_marginStart="@dimen/space_6"
                android:minWidth="0dp"
                android:text="Priority ▾" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/reminder_category_filter"
                style="@style/Widget.FamilyHub.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_target_min"
                android:layout_marginStart="@dimen/space_6"
                android:minWidth="0dp"
                android:text="Category ▾" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/reminder_status_filter"
                style="@style/Widget.FamilyHub.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_target_min"
                android:layout_marginStart="@dimen/space_6"
                android:minWidth="0dp"
                android:text="Status ▾" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/reminder_member_filter"
                style="@style/Widget.FamilyHub.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_target_min"
                android:layout_marginStart="@dimen/space_6"
                android:minWidth="0dp"
                android:text="Member ▾" />
        </LinearLayout>
    </HorizontalScrollView>

    <com.tridev.familyhub.feature.reminders.ReminderDashboardSummaryView
        android:id="@+id/reminder_dashboard_summary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/compact_section_spacing"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/reminders_overview" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/reminder_recycler_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="@dimen/space_16"
        android:paddingBottom="88dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/reminder_filter_scroll" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/reminders_empty_state"
        style="@style/Widget.FamilyHub.Card.Flat"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/compact_section_spacing"
        android:visibility="gone"
        app:cardBackgroundColor="@color/fh_module_reminders_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/reminder_filter_scroll"
        app:strokeColor="@color/fh_module_reminders">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/compact_empty_state_padding">

            <ImageView
                android:layout_width="@dimen/compact_empty_state_icon_size"
                android:layout_height="@dimen/compact_empty_state_icon_size"
                android:background="@drawable/bg_placeholder_icon"
                android:contentDescription="@null"
                android:padding="@dimen/compact_empty_state_icon_padding"
                android:src="@drawable/ic_reminder"
                app:tint="@color/fh_module_reminders" />

            <TextView
                style="@style/TextAppearance.FamilyHub.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/compact_section_spacing"
                android:gravity="center"
                android:text="@string/no_reminders_title" />

            <TextView
                style="@style/TextAppearance.FamilyHub.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:gravity="center"
                android:text="@string/no_reminders_detail"
                android:textAlignment="center" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/empty_add_reminder_button"
                style="@style/Widget.FamilyHub.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="@dimen/compact_section_spacing"
                android:text="@string/add_reminder_short"
                app:icon="@drawable/ic_add"
                app:iconGravity="textStart"
                app:iconPadding="@dimen/space_6" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
