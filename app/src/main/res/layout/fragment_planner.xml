<?xml version="1.0" encoding="utf-8"?>
<com.tridev.familyhub.core.ui.ScrollableWorkspaceLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:background="@drawable/bg_page_three_tone" android:padding="@dimen/space_8" android:paddingBottom="0dp">
    <com.tridev.familyhub.core.ui.cards.ModuleOverviewView android:id="@+id/planner_overview"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        app:overviewAccentColor="@color/fh_module_planner" app:overviewContainerColor="@color/fh_module_planner_container"
        app:overviewDetail="@string/planner_subtitle" app:overviewIcon="@drawable/ic_planner" app:overviewTitle="@string/planner_title" />
        <com.tridev.familyhub.core.ui.cards.ScheduleSummaryView android:id="@+id/planner_summary"
            android:layout_width="match_parent" android:layout_height="wrap_content" />
        <HorizontalScrollView android:id="@+id/planner_filter_scroll" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:scrollbars="none" android:layout_marginTop="@dimen/space_4">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton android:id="@+id/planner_status_filter"
                style="@style/Widget.FamilyHub.Button.Outlined" android:layout_width="wrap_content" android:layout_height="48dp"
                android:layout_marginEnd="4dp" android:minWidth="0dp" android:textSize="11sp" android:text="Pending ▾" />
            <com.google.android.material.button.MaterialButton android:id="@+id/planner_period_filter"
                style="@style/Widget.FamilyHub.Button.Outlined" android:layout_width="wrap_content" android:layout_height="48dp"
                android:layout_marginEnd="4dp" android:minWidth="0dp" android:textSize="11sp" android:text="All dates ▾" />
            <com.google.android.material.button.MaterialButton android:id="@+id/planner_type_filter"
                style="@style/Widget.FamilyHub.Button.Outlined" android:layout_width="wrap_content" android:layout_height="48dp"
                android:layout_marginEnd="4dp" android:minWidth="0dp" android:textSize="11sp" android:text="Type ▾" />
            <com.google.android.material.button.MaterialButton android:id="@+id/planner_priority_filter"
                style="@style/Widget.FamilyHub.Button.Outlined" android:layout_width="wrap_content" android:layout_height="48dp"
                android:layout_marginEnd="4dp" android:minWidth="0dp" android:textSize="11sp" android:text="Priority ▾" />
            <com.google.android.material.button.MaterialButton android:id="@+id/planner_sort_filter"
                style="@style/Widget.FamilyHub.Button.Outlined" android:layout_width="wrap_content" android:layout_height="48dp"
                android:layout_marginEnd="4dp" android:minWidth="0dp" android:textSize="11sp" android:text="Due ▾" />
        </LinearLayout></HorizontalScrollView>
        <com.google.android.material.textfield.TextInputLayout android:id="@+id/planner_search_layout"
            style="@style/Widget.FamilyHub.TextInputLayout" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="@string/planner_search_hint" app:startIconDrawable="@drawable/ic_search" app:startIconTint="@color/fh_module_planner">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/planner_search_input"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>
        <FrameLayout android:id="@+id/planner_quick_host" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" />
        <TextView android:id="@+id/planner_results" style="@style/TextAppearance.FamilyHub.Caption"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="6dp" />
        <!-- Keep elevated list cards within the viewport below the controls. -->
        <FrameLayout android:id="@+id/planner_list_host" android:layout_width="match_parent"
            android:layout_height="0dp" android:layout_weight="1" android:clipChildren="true" android:clipToPadding="true">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/planner_recycler_view"
            android:layout_width="match_parent" android:layout_height="match_parent" android:nestedScrollingEnabled="false" android:scrollbars="vertical" android:fadeScrollbars="false" android:paddingBottom="0dp" android:clipToPadding="true" android:clipChildren="true" />
        <LinearLayout android:id="@+id/planner_empty_state" android:layout_width="match_parent" android:layout_height="match_parent"
            android:orientation="vertical" android:gravity="center" android:padding="12dp" android:visibility="gone">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/planner_empty_title" />
            <com.google.android.material.button.MaterialButton android:id="@+id/empty_add_planner_button"
                android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/planner_add" />
        </LinearLayout>
        </FrameLayout>
</com.tridev.familyhub.core.ui.ScrollableWorkspaceLayout>
