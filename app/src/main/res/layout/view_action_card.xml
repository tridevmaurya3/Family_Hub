<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/action_card_surface"
    style="@style/Widget.FamilyHub.Card.Flat"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/fh_surface"
    app:strokeColor="@color/fh_outline"
    app:strokeWidth="@dimen/border_width">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="@dimen/space_8">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/action_card_icon_container"
                android:layout_width="30dp"
                android:layout_height="30dp"
                app:cardBackgroundColor="@color/fh_primary_container"
                app:cardCornerRadius="@dimen/radius_8"
                app:cardElevation="0dp"
                app:strokeColor="@color/fh_outline_variant"
                app:strokeWidth="@dimen/border_width">

                <ImageView
                    android:id="@+id/action_card_icon"
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_planner"
                    app:tint="@color/fh_primary" />

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/action_card_title"
                style="@style/TextAppearance.FamilyHub.CardTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_8"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/fh_on_surface"
                android:textSize="12sp" />

            <ImageView
                android:id="@+id/action_card_arrow"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_arrow_right"
                app:tint="@color/fh_text_secondary" />

        </LinearLayout>

        <TextView
            android:id="@+id/action_card_primary"
            style="@style/TextAppearance.FamilyHub.SectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/action_card_secondary"
            style="@style/TextAppearance.FamilyHub.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/fh_text_secondary"
            android:textSize="10sp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
