        <com.google.android.material.chip.ChipGroup android:id="@+id/global_search_filters" android:layout_width="wrap_content" android:layout_height="wrap_content" app:selectionRequired="true" app:singleSelection="true" app:chipSpacingHorizontal="6dp">
