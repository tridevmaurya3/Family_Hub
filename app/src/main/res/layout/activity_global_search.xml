<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/fh_background" android:paddingStart="@dimen/screen_padding_horizontal" android:paddingTop="@dimen/space_16" android:paddingEnd="@dimen/screen_padding_horizontal">
