<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_page_three_tone"
    android:paddingStart="@dimen/screen_padding_horizontal"
    android:paddingTop="@dimen/compact_page_top_padding"
    android:paddingEnd="@dimen/screen_padding_horizontal">

    <com.tridev.familyhub.core.ui.cards.ModuleOverviewView
        android:id="@+id/grocery_overview"
        android:layout_width="0dp"
        android:layout_height="76dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:overviewAccentColor="@color/fh_module_grocery"
        app:overviewContainerColor="@color/fh_module_grocery_container"
        app:overviewDetail="@string/grocery_subtitle"
        app:overviewIcon="@drawable/ic_grocery"
        app:overviewTitle="@string/grocery_title" />

    <LinearLayout
        android:id="@+id/grocery_summary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/grocery_overview">

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.FamilyHub.Card.Flat"
            android:layout_width="0dp"
            android:layout_height="68dp"
            android:layout_marginEnd="@dimen/space_4"
            android:layout_weight="1"
            app:cardBackgroundColor="@color/fh_primary_container">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:padding="8dp">
                <TextView
                    style="@style/TextAppearance.FamilyHub.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:text="@string/grocery_pending"
                    android:textSize="10sp" />
                <TextView
                    android:id="@+id/grocery_pending_value"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="0"
                    android:textColor="@color/fh_primary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.FamilyHub.Card.Flat"
            android:layout_width="0dp"
            android:layout_height="68dp"
            android:layout_marginStart="@dimen/space_4"
            android:layout_weight="1"
            app:cardBackgroundColor="@color/fh_warning_container">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:padding="8dp">
                <TextView style="@style/TextAppearance.FamilyHub.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="2" android:text="@string/grocery_budget" android:textSize="10sp" />
                <TextView android:id="@+id/grocery_budget_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:maxLines="1" android:text="₹0" android:textColor="@color/fh_warning" android:textSize="15sp" android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.FamilyHub.Card.Flat"
            android:layout_width="0dp"
            android:layout_height="68dp"
            android:layout_marginStart="@dimen/space_4"
            android:layout_weight="1"
            app:cardBackgroundColor="@color/fh_success_container">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:padding="8dp">
                <TextView
                    style="@style/TextAppearance.FamilyHub.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:text="@string/grocery_estimated_total"
                    android:textSize="10sp" />
                <TextView
                    android:id="@+id/grocery_total_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:text="₹0"
                    android:textColor="@color/fh_success"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.FamilyHub.Card.Flat"
            android:layout_width="0dp"
            android:layout_height="68dp"
            android:layout_marginStart="@dimen/space_4"
            android:layout_weight="1"
            app:cardBackgroundColor="@color/fh_form_accent_container">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:padding="8dp">
                <TextView
                    style="@style/TextAppearance.FamilyHub.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:text="@string/grocery_actual_total"
                    android:textSize="10sp" />
                <TextView
                    android:id="@+id/grocery_actual_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:text="₹0"
                    android:textColor="@color/fh_form_accent"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <FrameLayout
        android:id="@+id/grocery_search_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/grocery_summary">

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.FamilyHub.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/grocery_search_hint"
            app:startIconDrawable="@drawable/ic_search"
            app:startIconTint="@color/fh_success">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/grocery_search_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingEnd="96dp"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="end|center_vertical"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingEnd="4dp">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/grocery_filter_button"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="@string/grocery_filter_all"
                app:backgroundTint="@color/fh_transparent"
                app:icon="@drawable/ic_filter"
                app:iconSize="20dp"
                app:iconTint="@color/fh_module_grocery" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/grocery_export_button"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="@string/grocery_share_report"
                app:backgroundTint="@color/fh_transparent"
                app:icon="@drawable/ic_document_share"
                app:iconSize="20dp"
                app:iconTint="@color/fh_primary" />
        </LinearLayout>
    </FrameLayout>

    <HorizontalScrollView
        android:id="@+id/grocery_filter_scroll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:fillViewport="false"
        android:scrollbars="none"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/grocery_search_layout">
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/grocery_filter_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipSpacingHorizontal="@dimen/space_8"
            app:selectionRequired="true"
            app:singleSelection="true">
            <com.google.android.material.chip.Chip android:id="@+id/filter_all" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" android:text="@string/grocery_filter_all" android:textColor="@color/fh_primary_dark" app:chipBackgroundColor="@color/fh_primary_container" />
            <com.google.android.material.chip.Chip android:id="@+id/filter_daily" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/grocery_filter_daily" android:textColor="@color/fh_on_success_container" app:chipBackgroundColor="@color/fh_success_container" />
            <com.google.android.material.chip.Chip android:id="@+id/filter_monthly" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/grocery_filter_monthly" android:textColor="@color/fh_form_accent" app:chipBackgroundColor="@color/fh_form_accent_container" />
            <com.google.android.material.chip.Chip android:id="@+id/filter_pending" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/grocery_filter_pending" android:textColor="@color/fh_on_warning_container" app:chipBackgroundColor="@color/fh_warning_container" />
            <com.google.android.material.chip.Chip android:id="@+id/filter_purchased" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/grocery_filter_purchased" android:textColor="@color/fh_module_health" app:chipBackgroundColor="@color/fh_module_health_container" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <HorizontalScrollView
        android:id="@+id/grocery_action_scroll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fillViewport="false"
        android:scrollbars="none"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/grocery_filter_scroll">
      <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingEnd="16dp">
    <com.google.android.material.button.MaterialButton
        android:id="@+id/grocery_voice_button"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="@dimen/touch_target_min"
        android:layout_height="@dimen/touch_target_min"
        android:contentDescription="@string/grocery_voice_add"
        app:icon="@drawable/ic_mic"
        app:iconTint="@color/fh_primary" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/floating_grocery_button"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/touch_target_min"
        android:text="@string/grocery_floating_enable"
        android:textColor="@color/fh_module_grocery"
        app:icon="@drawable/ic_grocery"
        app:iconTint="@color/fh_module_grocery" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/grocery_budget_button"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/touch_target_min"
                android:text="@string/grocery_set_budget"
                android:textColor="@color/fh_warning" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/grocery_suggestions_button"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_target_min"
                android:text="@string/grocery_suggestions"
                android:textColor="@color/fh_module_grocery" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/grocery_due_calendar_button"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_target_min"
                android:text="Due calendar"
                android:textColor="@color/fh_info" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/grocery_shopping_mode_button"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_target_min"
                android:text="@string/grocery_shopping_mode"
                android:textColor="@color/fh_success"
                app:icon="@drawable/ic_grocery" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/grocery_scan_bill_button"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_target_min"
                android:text="@string/grocery_scan_bill"
                android:textColor="@color/fh_primary"
                app:icon="@drawable/ic_document_camera" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/grocery_store_analytics_button"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_target_min"
                android:text="@string/grocery_store_analytics"
                android:textColor="@color/fh_module_grocery"
                app:icon="@drawable/ic_grocery" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/grocery_pdf_button"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_target_min"
                android:visibility="gone"
                android:text="@string/grocery_export_pdf"
                app:icon="@drawable/ic_file_pdf" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/grocery_excel_button"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_target_min"
                android:visibility="gone"
                android:text="@string/grocery_export_excel"
                app:icon="@drawable/ic_file_excel" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/grocery_share_button"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_target_min"
                android:visibility="gone"
                android:text="@string/grocery_share_report"
                app:icon="@drawable/ic_document_share" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/clear_purchased_button"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/touch_target_min"
        android:text="@string/grocery_clear_purchased"
        android:textColor="@color/fh_primary" />
      </LinearLayout>
    </HorizontalScrollView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/grocery_recycler_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="@dimen/space_8"
        android:paddingBottom="88dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/grocery_action_scroll" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/grocery_empty_state"
        style="@style/Widget.FamilyHub.Card.Flat"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_16"
        android:visibility="gone"
        app:cardBackgroundColor="@color/fh_success_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/grocery_action_scroll"
        app:strokeColor="@color/fh_success">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/compact_empty_state_padding">
            <ImageView
                android:layout_width="@dimen/compact_empty_state_icon_size"
                android:layout_height="@dimen/compact_empty_state_icon_size"
                android:background="@drawable/bg_placeholder_icon"
                android:contentDescription="@null"
                android:padding="@dimen/compact_empty_state_icon_padding"
                android:src="@drawable/ic_grocery"
                app:tint="@color/fh_success" />
            <TextView
                style="@style/TextAppearance.FamilyHub.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/compact_section_spacing"
                android:text="@string/grocery_empty_title" />
            <TextView
                style="@style/TextAppearance.FamilyHub.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:gravity="center"
                android:text="@string/grocery_empty_detail"
                android:textAlignment="center" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/empty_add_grocery_button"
                style="@style/Widget.FamilyHub.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="@dimen/compact_section_spacing"
                android:text="@string/grocery_add_item"
                app:icon="@drawable/ic_add" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
