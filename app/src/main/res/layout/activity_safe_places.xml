<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_page_three_tone"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding_horizontal"
        android:paddingTop="@dimen/compact_page_top_padding"
        android:paddingEnd="@dimen/screen_padding_horizontal"
        android:paddingBottom="@dimen/space_24">

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.FamilyHub.Card.Flat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/fh_surface"
            app:cardCornerRadius="@dimen/radius_20"
            app:strokeColor="@color/fh_outline_variant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/space_12">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_back"
                    style="@style/Widget.FamilyHub.Button.Tonal"
                    android:layout_width="@dimen/touch_target_min"
                    android:layout_height="@dimen/touch_target_min"
                    android:contentDescription="@string/action_back"
                    android:minWidth="0dp"
                    android:text=""
                    app:backgroundTint="@color/fh_primary_container"
                    app:icon="@drawable/ic_arrow_back"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconTint="@color/fh_primary" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_marginStart="@dimen/space_12"
                    android:layout_weight="1" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_alert_history"
            style="@style/Widget.FamilyHub.Button.Tonal"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="@dimen/space_12"
            android:gravity="center_vertical|start"
            android:text="@string/safe_place_alert_history_title"
            android:textAlignment="viewStart"
            android:textColor="@color/fh_secondary"
            app:backgroundTint="@color/fh_secondary_container"
            app:icon="@drawable/ic_safe_place_history"
            app:iconGravity="textStart"
            app:iconPadding="@dimen/space_12"
            app:iconTint="@color/fh_secondary"
            app:strokeColor="@color/fh_secondary"
            app:strokeWidth="1dp" />

        <TextView
            style="@style/TextAppearance.FamilyHub.Overline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/compact_section_spacing"
            android:text="@string/safe_place_saved_places_section"
            android:textColor="@color/fh_primary" />

        <TextView
            style="@style/TextAppearance.FamilyHub.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/safe_place_saved_places_helper" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.FamilyHub.Card.Flat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            app:cardBackgroundColor="@color/fh_surface"
            app:cardCornerRadius="@dimen/radius_18"
            app:strokeColor="@color/fh_outline_variant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:id="@+id/safe_place_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="72dp"
                android:orientation="vertical"
                android:padding="@dimen/space_12" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/TextAppearance.FamilyHub.Overline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/compact_section_spacing"
            android:text="@string/safe_place_create_section"
            android:textColor="@color/fh_primary" />

        <TextView
            style="@style/TextAppearance.FamilyHub.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/safe_place_create_helper" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.FamilyHub.Card.Flat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            app:cardBackgroundColor="@color/fh_surface"
            app:cardCornerRadius="@dimen/radius_18"
            app:strokeColor="@color/fh_outline_variant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.FamilyHub.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/safe_place_name"
                    app:startIconDrawable="@drawable/ic_safe_place_pin"
                    app:startIconTint="@color/fh_primary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/safe_place_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionNext"
                        android:inputType="textCapWords"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.FamilyHub.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:hint="@string/safe_place_type"
                    app:endIconMode="dropdown_menu"
                    app:startIconDrawable="@drawable/ic_family_map_layers"
                    app:startIconTint="@color/fh_module_documents">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/safe_place_type"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:maxLines="1"
                        android:minHeight="56dp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.FamilyHub.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:hint="@string/safe_place_radius"
                    app:helperText="@string/safe_place_radius_helper"
                    app:startIconDrawable="@drawable/ic_family_map_recenter"
                    app:startIconTint="@color/fh_secondary"
                    app:suffixText="m">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/safe_place_radius"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionDone"
                        android:inputType="number"
                        android:maxLines="1"
                        android:text="200" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/TextAppearance.FamilyHub.Overline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/compact_section_spacing"
            android:text="@string/safe_place_location_section"
            android:textColor="@color/fh_primary" />

        <TextView
            style="@style/TextAppearance.FamilyHub.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/safe_place_location_helper" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.FamilyHub.Card.Flat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            app:cardBackgroundColor="@color/fh_surface"
            app:cardCornerRadius="@dimen/radius_18"
            app:strokeColor="@color/fh_outline_variant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_use_location"
                    style="@style/Widget.FamilyHub.Button.Tonal"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:gravity="center_vertical|start"
                    android:text="@string/safe_place_use_location"
                    android:textAlignment="viewStart"
                    android:textColor="@color/fh_secondary"
                    app:backgroundTint="@color/fh_secondary_container"
                    app:icon="@drawable/ic_family_map_recenter"
                    app:iconGravity="textStart"
                    app:iconPadding="@dimen/space_12"
                    app:iconTint="@color/fh_secondary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_select_on_map"
                    style="@style/Widget.FamilyHub.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="@dimen/space_10"
                    android:gravity="center_vertical|start"
                    android:text="@string/safe_place_select_on_map"
                    android:textAlignment="viewStart"
                    android:textColor="@color/fh_primary"
                    app:icon="@drawable/ic_safe_place_pin"
                    app:iconGravity="textStart"
                    app:iconPadding="@dimen/space_12"
                    app:iconTint="@color/fh_primary"
                    app:strokeColor="@color/fh_primary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:background="@drawable/bg_family_map_info_window"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_12">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_safe_place_pin"
                        app:tint="@color/fh_primary" />

                    <TextView
                        android:id="@+id/location_status"
                        style="@style/TextAppearance.FamilyHub.BodyStrong"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_10"
                        android:layout_weight="1"
                        android:text="@string/safe_place_location_waiting"
                        android:textColor="@color/fh_text_primary" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/TextAppearance.FamilyHub.Overline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/compact_section_spacing"
            android:text="@string/safe_place_readiness_section"
            android:textColor="@color/fh_primary" />

        <TextView
            style="@style/TextAppearance.FamilyHub.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/safe_place_readiness_helper" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.FamilyHub.Card.Flat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            app:cardBackgroundColor="@color/fh_success_container"
            app:cardCornerRadius="@dimen/radius_18"
            app:strokeColor="@color/fh_success"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_safe_place_shield"
                        app:tint="@color/fh_success" />

                    <TextView
                        android:id="@+id/safe_place_permission_status"
                        style="@style/TextAppearance.FamilyHub.BodyStrong"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_10"
                        android:layout_weight="1"
                        android:text="@string/safe_place_permission_checking"
                        android:textColor="@color/fh_on_success_container" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_safe_place_settings"
                    style="@style/Widget.FamilyHub.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_gravity="end"
                    android:layout_marginTop="@dimen/space_8"
                    android:text="@string/safe_place_open_settings"
                    android:textColor="@color/fh_success" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_save"
            style="@style/Widget.FamilyHub.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="@dimen/space_16"
            android:text="@string/safe_place_save"
            app:icon="@drawable/ic_safe_place_shield"
            app:iconGravity="textStart"
            app:iconPadding="@dimen/space_10" />

        <TextView
            style="@style/TextAppearance.FamilyHub.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:gravity="center"
            android:text="@string/safe_place_save_helper"
            android:textAlignment="center"
            android:textColor="@color/fh_text_secondary" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
