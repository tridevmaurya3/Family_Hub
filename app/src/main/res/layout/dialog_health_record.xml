<?xml version='1.0' encoding='UTF-8'?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_form_floating_shell"
    android:overScrollMode="never"
    android:scrollbars="none">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingTop="6dp"
        android:paddingEnd="8dp"
        android:paddingBottom="10dp">
        <com.google.android.material.card.MaterialCardView
            android:layout_width="36dp"
            android:layout_height="3dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="6dp"
            app:cardBackgroundColor="@color/fh_outline_variant"
            app:cardCornerRadius="2dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"/>
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.FamilyHub.Form.Header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/fh_module_health_container"
            app:strokeColor="@color/fh_module_health"
            app:cardCornerRadius="12dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="8dp">
                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_placeholder_icon"
                    android:contentDescription="@null"
                    android:padding="7dp"
                    android:src="@drawable/ic_health"
                    app:tint="@color/fh_module_health"/>
                <TextView
                    android:id="@+id/health_dialog_title"
                    style="@style/TextAppearance.FamilyHub.SectionTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_12"
                    android:layout_weight="1"
                    android:text="@string/health_add_record"
                    android:textColor="@color/fh_module_health"
                    android:textSize="15sp"
                    android:maxLines="1"
                    android:ellipsize="end"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.FamilyHub.Form.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:cardCornerRadius="12dp"
            app:cardBackgroundColor="@color/fh_primary_container"
            app:strokeColor="@color/fh_primary">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="7dp">
                <TextView
                    style="@style/TextAppearance.FamilyHub.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="@string/form_section_details"
                    android:textColor="@color/fh_primary"
                    android:textSize="11sp"
                    android:textStyle="bold"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="5dp">
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/health_member_layout"
                        style="@style/Widget.FamilyHub.FloatingCompact.Dropdown"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="0dp"
                        android:hint="@string/health_family_member"
                        app:endIconMode="dropdown_menu"
                        android:layout_weight="1"
                        android:layout_marginEnd="3dp">
                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/health_member_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textSize="12sp"/>
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/health_type_layout"
                        style="@style/Widget.FamilyHub.FloatingCompact.Dropdown"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="0dp"
                        android:hint="@string/health_record_type"
                        app:endIconMode="dropdown_menu"
                        android:layout_weight="1"
                        android:layout_marginStart="3dp">
                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/health_type_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textSize="12sp"/>
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/form_field_spacing"
            android:orientation="horizontal">
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.FamilyHub.FloatingCompact.Field"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_4"
                android:layout_weight="1"
                android:hint="@string/health_record_time">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/health_time_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:cursorVisible="false"
                    android:focusable="false"
                    android:inputType="none"/>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.FamilyHub.FloatingCompact.Dropdown"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_4"
                android:layout_weight="1.25"
                android:hint="@string/health_remind_before"
                app:endIconMode="dropdown_menu">
                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/health_reminder_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"/>
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.FamilyHub.Form.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:cardCornerRadius="12dp"
            app:cardBackgroundColor="@color/fh_primary_container"
            app:strokeColor="@color/fh_primary">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="7dp">
                <TextView
                    style="@style/TextAppearance.FamilyHub.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="@string/form_section_options"
                    android:textColor="@color/fh_primary"
                    android:textSize="11sp"
                    android:textStyle="bold"/>
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/health_title_layout"
                    style="@style/Widget.FamilyHub.FloatingCompact.Field"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:hint="@string/health_record_title">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/health_title_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapSentences"
                        android:maxLines="1"/>
                </com.google.android.material.textfield.TextInputLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="5dp">
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.FamilyHub.FloatingCompact.Field"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="0dp"
                        android:hint="@string/health_value"
                        android:layout_weight="1"
                        android:layout_marginEnd="3dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/health_value_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapSentences"
                            android:maxLines="1"/>
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.FamilyHub.FloatingCompact.Field"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="0dp"
                        android:hint="@string/health_record_date"
                        android:layout_weight="1"
                        android:layout_marginStart="3dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/health_date_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clickable="true"
                            android:cursorVisible="false"
                            android:focusable="false"
                            android:inputType="none"/>
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.FamilyHub.Form.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:cardCornerRadius="12dp"
            app:cardBackgroundColor="@color/fh_primary_container"
            app:strokeColor="@color/fh_primary">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="7dp">
                <TextView
                    style="@style/TextAppearance.FamilyHub.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="@string/form_section_more"
                    android:textColor="@color/fh_primary"
                    android:textSize="11sp"
                    android:textStyle="bold"/>
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.FamilyHub.FloatingCompact.Field"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:hint="@string/health_notes">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/health_notes_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top"
                        android:inputType="textCapSentences|textMultiLine"
                        android:maxLines="4"
                        android:minLines="2"/>
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.FamilyHub.FloatingCompact.Dropdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:hint="@string/linked_document"
                    app:endIconMode="dropdown_menu">
                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/health_linked_document_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"/>
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.FamilyHub.FloatingCompact.Field"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:hint="@string/timeline_note">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/health_timeline_note_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapSentences|textMultiLine"/>
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                    style="@style/Widget.FamilyHub.FloatingCompact.Switch"
                    android:id="@+id/health_shared_switch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/health_share_with_family"
                    android:textColor="@color/fh_on_surface"
                    android:textSize="13sp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/cancel_health_button"
                style="@style/Widget.FamilyHub.Form.CompactCancel"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="@dimen/space_4"
                android:layout_weight="1"
                android:text="@string/cancel"
                android:minHeight="40dp"
                android:textSize="11.5sp"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/save_health_button"
                style="@style/Widget.FamilyHub.FloatingCompact.PrimaryAction"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="@dimen/space_4"
                android:layout_weight="1.25"
                android:text="@string/health_save_record"
                app:icon="@drawable/ic_health"
                app:iconGravity="textStart"
                app:iconPadding="@dimen/space_6"
                android:minHeight="40dp"/>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>