<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/status_card_surface"
    style="@style/Widget.FamilyHub.Card.Flat"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/fh_surface"
    app:strokeColor="@color/fh_outline">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_8"
        android:paddingTop="@dimen/space_6"
        android:paddingEnd="@dimen/space_8"
        android:paddingBottom="@dimen/space_6">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/status_icon_container"
            android:layout_width="34dp"
            android:layout_height="34dp"
            app:cardBackgroundColor="@color/fh_primary_container"
            app:cardCornerRadius="@dimen/radius_8"
            app:cardElevation="0dp"
            app:strokeColor="@color/fh_outline_variant"
            app:strokeWidth="@dimen/border_width">

            <ImageView
                android:id="@+id/imgStatusIcon"
                android:layout_width="19dp"
                android:layout_height="19dp"
                android:layout_gravity="center"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_wallet"
                app:tint="@color/fh_primary" />

        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_8"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtStatusTitle"
                style="@style/TextAppearance.FamilyHub.CardTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/monthly_spend"
                android:textColor="@color/fh_on_surface"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/txtStatusSubtitle"
                style="@style/TextAppearance.FamilyHub.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/monthly_spend_detail"
                android:textColor="@color/fh_text_secondary"
                android:textSize="10sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/txtStatusValue"
            style="@style/TextAppearance.FamilyHub.SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_8"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/monthly_spend_value"
            android:textColor="@color/fh_primary"
            android:textSize="13sp" />

        <ImageView
            android:id="@+id/status_card_arrow"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginStart="@dimen/space_6"
            android:contentDescription="@null"
            android:src="@drawable/ic_arrow_right"
            app:tint="@color/fh_text_secondary" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
