<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_page_three_tone"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding_horizontal"
        android:paddingTop="@dimen/compact_page_top_padding"
        android:paddingEnd="@dimen/screen_padding_horizontal"
        android:paddingBottom="@dimen/space_32">

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.FamilyHub.Card.Flat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/fh_surface"
            app:cardCornerRadius="@dimen/radius_20"
            app:strokeColor="@color/fh_outline_variant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/space_12">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonProfileBack"
                    style="@style/Widget.FamilyHub.Button.Tonal"
                    android:layout_width="@dimen/touch_target_min"
                    android:layout_height="@dimen/touch_target_min"
                    android:contentDescription="@string/action_back"
                    android:minWidth="0dp"
                    android:text=""
                    app:icon="@drawable/ic_arrow_back"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconTint="@color/fh_primary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_12"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextAppearance.FamilyHub.Heading"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_title" />

                    <TextView
                        style="@style/TextAppearance.FamilyHub.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/profile_subtitle" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/progressProfile"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.FamilyHub.Card.Flat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            app:cardBackgroundColor="@color/fh_primary_container"
            app:cardCornerRadius="@dimen/radius_20"
            app:strokeColor="@color/fh_primary"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="@dimen/space_20">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="104dp"
                    android:layout_height="104dp"
                    app:cardBackgroundColor="@color/fh_surface"
                    app:cardCornerRadius="52dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/fh_primary"
                    app:strokeWidth="2dp">

                    <ImageView
                        android:id="@+id/imageProfilePhoto"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/profile_photo_description"
                        android:padding="24dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_profile_person" />
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonProfileChangePhoto"
                        style="@style/Widget.FamilyHub.Button.Tonal"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/touch_target_min"
                        android:text="@string/profile_change_photo"
                        android:textAllCaps="false"
                        app:icon="@drawable/ic_add"
                        app:iconTint="@color/fh_primary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonProfileRemovePhoto"
                        style="@style/Widget.FamilyHub.Button.Tonal"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/touch_target_min"
                        android:layout_marginStart="@dimen/space_8"
                        android:text="@string/profile_remove_photo"
                        android:textAllCaps="false" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/TextAppearance.FamilyHub.Overline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/compact_section_spacing"
            android:text="@string/profile_personal_section"
            android:textColor="@color/fh_primary" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_10"
            android:hint="@string/profile_display_name">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputProfileName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName"
                android:maxLength="100"
                android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.FamilyHub.Card.Flat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_10"
            app:cardBackgroundColor="@color/fh_surface"
            app:strokeColor="@color/fh_outline_variant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_14">

                <TextView
                    style="@style/TextAppearance.FamilyHub.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_email" />

                <TextView
                    android:id="@+id/textProfileEmail"
                    style="@style/TextAppearance.FamilyHub.BodyStrong"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/profile_unknown" />

                <TextView
                    style="@style/TextAppearance.FamilyHub.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_10"
                    android:text="@string/profile_family" />

                <TextView
                    android:id="@+id/textProfileFamily"
                    style="@style/TextAppearance.FamilyHub.BodyStrong"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/profile_unknown" />

                <TextView
                    style="@style/TextAppearance.FamilyHub.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_10"
                    android:text="@string/profile_role" />

                <TextView
                    android:id="@+id/textProfileRole"
                    style="@style/TextAppearance.FamilyHub.BodyStrong"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/profile_unknown" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonProfileSave"
            style="@style/Widget.FamilyHub.Button.Action"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="@dimen/space_12"
            android:text="@string/profile_save"
            android:textAllCaps="false" />

        <TextView
            style="@style/TextAppearance.FamilyHub.Overline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/compact_section_spacing"
            android:text="@string/profile_preferences_section"
            android:textColor="@color/fh_primary" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.FamilyHub.Card.Flat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_10"
            app:cardBackgroundColor="@color/fh_surface"
            app:strokeColor="@color/fh_outline_variant"
            app:strokeWidth="1dp">

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchProfileDarkTheme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/space_14"
                android:text="@string/profile_dark_theme" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardProfileNotifications"
            style="@style/Widget.FamilyHub.Card.Flat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="@color/fh_info_container"
            app:strokeColor="@color/fh_info"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_14">

                <TextView
                    style="@style/TextAppearance.FamilyHub.CardTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_notifications"
                    android:textColor="@color/fh_info" />

                <TextView
                    style="@style/TextAppearance.FamilyHub.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/profile_notifications_detail" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardProfileFamilySettings"
            style="@style/Widget.FamilyHub.Card.Flat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="@color/fh_module_family_container"
            app:strokeColor="@color/fh_module_family"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_14">

                <TextView
                    style="@style/TextAppearance.FamilyHub.CardTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_family_settings"
                    android:textColor="@color/fh_module_family" />

                <TextView
                    style="@style/TextAppearance.FamilyHub.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/profile_family_settings_detail" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/TextAppearance.FamilyHub.Overline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/compact_section_spacing"
            android:text="@string/profile_account_section"
            android:textColor="@color/fh_error" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonProfileLogout"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="@dimen/space_10"
            android:text="@string/profile_logout"
            android:textAllCaps="false"
            android:textColor="@color/fh_error"
            app:strokeColor="@color/fh_error" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
