<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/backupRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@drawable/bg_page_three_tone">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding_horizontal"
            android:paddingTop="@dimen/compact_page_top_padding"
            android:paddingEnd="@dimen/screen_padding_horizontal"
            android:paddingBottom="96dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonBackupBack"
                    style="@style/Widget.FamilyHub.Button.Tonal"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@string/backup_back_description"
                    android:minWidth="0dp"
                    android:text=""
                    app:icon="@drawable/ic_arrow_back"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="20dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_12"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextAppearance.FamilyHub.Heading"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/backup_title" />

                    <TextView
                        style="@style/TextAppearance.FamilyHub.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:text="@string/backup_subtitle" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.FamilyHub.Card.Flat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                app:cardBackgroundColor="@color/fh_primary_container"
                app:strokeColor="@color/fh_primary">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            app:cardBackgroundColor="@color/fh_surface"
                            app:cardCornerRadius="@dimen/radius_14"
                            app:cardElevation="0dp">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_backup_secure"
                                app:tint="@color/fh_primary" />
                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_12"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/textBackupReadiness"
                                style="@style/TextAppearance.FamilyHub.SectionTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/backup_status_need_both"
                                android:textColor="@color/fh_primary" />

                            <TextView
                                android:id="@+id/textBackupDestination"
                                style="@style/TextAppearance.FamilyHub.Caption"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_4"
                                android:text="@string/backup_destination_not_selected" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        style="@style/TextAppearance.FamilyHub.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_10"
                        android:background="@drawable/bg_status_pill"
                        android:paddingStart="@dimen/space_8"
                        android:paddingTop="@dimen/space_4"
                        android:paddingEnd="@dimen/space_8"
                        android:paddingBottom="@dimen/space_4"
                        android:text="@string/backup_security_badge"
                        android:textColor="@color/fh_primary"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonChooseBackupFolder"
                        style="@style/Widget.FamilyHub.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_12"
                        android:text="@string/backup_choose_folder"
                        app:icon="@drawable/ic_backup_folder"
                        app:iconGravity="textStart" />

                    <TextView
                        style="@style/TextAppearance.FamilyHub.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_6"
                        android:text="@string/backup_folder_hint" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/TextAppearance.FamilyHub.Overline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/compact_section_spacing"
                android:text="@string/backup_password_section"
                android:textColor="@color/fh_primary" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.FamilyHub.Card.FormSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <TextView
                        style="@style/TextAppearance.FamilyHub.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/backup_password_explanation" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutBackupPassword"
                        style="@style/Widget.FamilyHub.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_12"
                        android:hint="@string/backup_password_hint"
                        app:endIconMode="password_toggle"
                        app:startIconDrawable="@drawable/ic_lock">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/inputBackupPassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword"
                            android:maxLength="128"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutBackupPasswordConfirm"
                        style="@style/Widget.FamilyHub.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:hint="@string/backup_password_confirm_hint"
                        app:endIconMode="password_toggle"
                        app:startIconDrawable="@drawable/ic_lock">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/inputBackupPasswordConfirm"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword"
                            android:maxLength="128"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        style="@style/TextAppearance.FamilyHub.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_6"
                        android:text="@string/backup_password_requirements" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonSaveBackupPassword"
                        style="@style/Widget.FamilyHub.Button.Tonal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_12"
                        android:text="@string/backup_save_password"
                        app:icon="@drawable/ic_backup_secure"
                        app:iconGravity="textStart" />

                    <TextView
                        android:id="@+id/textBackupPasswordSaved"
                        style="@style/TextAppearance.FamilyHub.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:text="@string/backup_password_saved"
                        android:textColor="@color/fh_success"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/TextAppearance.FamilyHub.Overline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/compact_section_spacing"
                android:text="@string/backup_manual_section"
                android:textColor="@color/fh_primary" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.FamilyHub.Card.Flat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <TextView
                        style="@style/TextAppearance.FamilyHub.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/backup_manual_detail" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonBackupNow"
                        style="@style/Widget.FamilyHub.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_12"
                        android:text="@string/backup_now"
                        app:icon="@drawable/ic_backup_secure"
                        app:iconGravity="textStart" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonRestoreBackup"
                        style="@style/Widget.FamilyHub.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:text="@string/backup_restore"
                        app:icon="@drawable/ic_backup_restore"
                        app:iconGravity="textStart" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/TextAppearance.FamilyHub.Overline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/compact_section_spacing"
                android:text="@string/backup_schedule_section"
                android:textColor="@color/fh_primary" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.FamilyHub.Card.Flat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchAutomaticBackup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/backup_schedule_switch"
                        android:textColor="@color/fh_on_surface" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.FamilyHub.Form.Dropdown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_12"
                        android:hint="@string/backup_frequency_hint"
                        app:startIconDrawable="@drawable/ic_backup_schedule">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/inputBackupFrequency"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchBackupWifiOnly"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:text="@string/backup_wifi_only"
                        android:textColor="@color/fh_on_surface" />

                    <TextView
                        style="@style/TextAppearance.FamilyHub.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_4"
                        android:text="@string/backup_wifi_only_detail" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchBackupChargingOnly"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:text="@string/backup_charging_only"
                        android:textColor="@color/fh_on_surface" />

                    <TextView
                        style="@style/TextAppearance.FamilyHub.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_4"
                        android:text="@string/backup_charging_only_detail" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonSaveBackupSchedule"
                        style="@style/Widget.FamilyHub.Button.Tonal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_12"
                        android:text="@string/backup_save_schedule"
                        app:icon="@drawable/ic_backup_schedule"
                        app:iconGravity="textStart" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/TextAppearance.FamilyHub.Overline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/compact_section_spacing"
                android:text="@string/backup_last_section"
                android:textColor="@color/fh_primary" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.FamilyHub.Card.Subtle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <TextView
                        android:id="@+id/textLastBackupTime"
                        style="@style/TextAppearance.FamilyHub.SectionTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/backup_never" />

                    <TextView
                        android:id="@+id/textLastBackupFile"
                        style="@style/TextAppearance.FamilyHub.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_6"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/textLastBackupSummary"
                        style="@style/TextAppearance.FamilyHub.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/textLastBackupError"
                        style="@style/TextAppearance.FamilyHub.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_6"
                        android:textColor="@color/fh_error"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/TextAppearance.FamilyHub.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:gravity="center"
                android:text="@string/backup_privacy_note"
                android:textAlignment="center" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <FrameLayout
        android:id="@+id/backupProgressOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.FamilyHub.Card.Flat"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="@dimen/space_24">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/space_24">

                <ProgressBar
                    android:id="@+id/progressBackupOperation"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:indeterminate="false"
                    android:max="100" />

                <TextView
                    android:id="@+id/textBackupProgressStage"
                    style="@style/TextAppearance.FamilyHub.SectionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16"
                    android:gravity="center"
                    android:text="@string/backup_progress_preparing"
                    android:textAlignment="center" />

                <TextView
                    style="@style/TextAppearance.FamilyHub.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:gravity="center"
                    android:text="@string/backup_operation_running"
                    android:textAlignment="center" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
