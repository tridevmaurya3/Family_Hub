<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_page_three_tone"
    android:paddingStart="@dimen/screen_padding_horizontal"
    android:paddingTop="@dimen/space_10"
    android:paddingEnd="@dimen/screen_padding_horizontal">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/vehicle_header_card"
        style="@style/Widget.FamilyHub.Card.Flat"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/fh_surface"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:strokeColor="@color/fh_outline">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/space_10">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="@dimen/space_10"
                app:cardBackgroundColor="@color/fh_module_vehicle_container"
                app:cardCornerRadius="@dimen/radius_12"
                app:cardElevation="0dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_vehicle"
                    app:tint="@color/fh_module_vehicle" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/vehicle_title"
                    style="@style/TextAppearance.FamilyHub.Heading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/vehicle_title"
                    android:textColor="@color/fh_on_surface"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/vehicle_subtitle"
                    style="@style/TextAppearance.FamilyHub.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:maxLines="2"
                    android:text="@string/vehicle_subtitle"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:id="@+id/vehicle_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_8"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/vehicle_header_card">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:orientation="horizontal"
            android:weightSum="4">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.FamilyHub.Card.Subtle"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_marginEnd="3dp" android:layout_weight="1">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                    android:gravity="center" android:orientation="vertical">
                    <TextView android:id="@+id/vehicle_total_value"
                        style="@style/TextAppearance.FamilyHub.SectionTitle"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="0" android:textColor="@color/fh_module_vehicle"
                        android:textSize="16sp" />
                    <TextView style="@style/TextAppearance.FamilyHub.Caption"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Vehicles" android:textSize="9sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.FamilyHub.Card.Subtle"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_marginHorizontal="3dp" android:layout_weight="1">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                    android:gravity="center" android:orientation="vertical">
                    <TextView android:id="@+id/vehicle_due_soon_value"
                        style="@style/TextAppearance.FamilyHub.SectionTitle"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="0" android:textColor="@color/fh_warning"
                        android:textSize="16sp" />
                    <TextView style="@style/TextAppearance.FamilyHub.Caption"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Due soon" android:textSize="9sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.FamilyHub.Card.Subtle"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_marginHorizontal="3dp" android:layout_weight="1">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                    android:gravity="center" android:orientation="vertical">
                    <TextView android:id="@+id/vehicle_overdue_value"
                        style="@style/TextAppearance.FamilyHub.SectionTitle"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="0" android:textColor="@color/fh_error"
                        android:textSize="16sp" />
                    <TextView style="@style/TextAppearance.FamilyHub.Caption"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Overdue" android:textSize="9sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.FamilyHub.Card.Subtle"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_marginStart="3dp" android:layout_weight="1">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                    android:gravity="center" android:orientation="vertical">
                    <TextView android:id="@+id/vehicle_service_value"
                        style="@style/TextAppearance.FamilyHub.SectionTitle"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="0" android:textColor="@color/fh_info"
                        android:textSize="16sp" />
                    <TextView style="@style/TextAppearance.FamilyHub.Caption"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Service" android:textSize="9sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.FamilyHub.Card.Flat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            app:cardBackgroundColor="@color/fh_surface"
            app:strokeColor="@color/fh_outline">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_8">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/vehicle_search_layout"
                    style="@style/Widget.FamilyHub.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/vehicle_search_hint"
                    app:endIconMode="clear_text"
                    app:startIconDrawable="@drawable/ic_search"
                    app:startIconTint="@color/fh_module_vehicle">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/vehicle_search_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_6"
                    android:scrollbars="none">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/vehicle_filter_group"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:selectionRequired="true"
                        app:singleLine="true"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/vehicle_filter_all"
                            style="@style/Widget.FamilyHub.StatusChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checkable="true"
                            android:checked="true"
                            android:text="All" />
                        <com.google.android.material.chip.Chip
                            android:id="@+id/vehicle_filter_cars"
                            style="@style/Widget.FamilyHub.StatusChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checkable="true"
                            android:text="Cars" />
                        <com.google.android.material.chip.Chip
                            android:id="@+id/vehicle_filter_two_wheelers"
                            style="@style/Widget.FamilyHub.StatusChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checkable="true"
                            android:text="Two-wheelers" />
                        <com.google.android.material.chip.Chip
                            android:id="@+id/vehicle_filter_due"
                            style="@style/Widget.FamilyHub.StatusChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checkable="true"
                            android:text="Due attention" />
                    </com.google.android.material.chip.ChipGroup>
                </HorizontalScrollView>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/space_8"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/vehicle_recycler_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="@dimen/space_4"
                android:paddingBottom="88dp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/vehicle_empty_state"
                style="@style/Widget.FamilyHub.Card.Flat"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                app:cardBackgroundColor="@color/fh_module_vehicle_container"
                app:strokeColor="@color/fh_module_vehicle">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_placeholder_icon"
                        android:contentDescription="@null"
                        android:padding="12dp"
                        android:src="@drawable/ic_vehicle"
                        app:tint="@color/fh_module_vehicle" />

                    <TextView
                        style="@style/TextAppearance.FamilyHub.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_10"
                        android:text="@string/vehicle_empty_title" />

                    <TextView
                        style="@style/TextAppearance.FamilyHub.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:gravity="center"
                        android:maxLines="2"
                        android:text="@string/vehicle_empty_detail"
                        android:textAlignment="center"
                        android:textSize="11sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/empty_add_vehicle_button"
                        style="@style/Widget.FamilyHub.Button.Primary"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/button_height"
                        android:layout_marginTop="@dimen/space_12"
                        android:text="@string/vehicle_add"
                        app:icon="@drawable/ic_add"
                        app:iconGravity="textStart" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </FrameLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
