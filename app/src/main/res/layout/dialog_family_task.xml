<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_form_floating_shell"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingTop="6dp"
        android:paddingEnd="8dp"
        android:paddingBottom="10dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="36dp"
            android:layout_height="3dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="6dp"
            app:cardBackgroundColor="@color/fh_outline_variant"
            app:cardCornerRadius="2dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.FamilyHub.Form.Header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/fh_success_container"
            app:cardCornerRadius="12dp"
            app:strokeColor="@color/fh_success">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="8dp">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_placeholder_icon"
                    android:contentDescription="@null"
                    android:padding="7dp"
                    android:src="@drawable/ic_family_task"
                    app:tint="@color/fh_success" />

                <TextView
                    android:id="@+id/task_dialog_title"
                    style="@style/TextAppearance.FamilyHub.SectionTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="@string/family_tasks_add"
                    android:textColor="@color/fh_success"
                    android:textSize="15sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.FamilyHub.Form.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:cardBackgroundColor="@color/fh_surface_container"
            app:cardCornerRadius="12dp"
            app:strokeColor="@color/fh_outline_variant">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="7dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/task_title_layout"
                    style="@style/Widget.FamilyHub.FloatingCompact.Field"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/family_tasks_name"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:endIconMode="custom"
                    app:endIconDrawable="@drawable/ic_mic"
                    app:endIconContentDescription="@string/family_tasks_voice_add"
                    app:endIconTint="@color/fh_primary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/task_title_input"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:gravity="center_vertical"
                        android:includeFontPadding="false"
                        android:inputType="textCapSentences"
                        android:maxLines="1"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:textSize="12sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:scrollbars="none">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/task_due_presets"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:chipSpacingHorizontal="3dp"
                        app:singleLine="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/task_due_today"
                            style="@style/Widget.Material3.Chip.Assist"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:minHeight="36dp"
                            android:text="@string/task_due_today"
                            android:textSize="11sp"
                            app:chipCornerRadius="12dp" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/task_due_tomorrow"
                            style="@style/Widget.Material3.Chip.Assist"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:minHeight="36dp"
                            android:text="@string/task_due_tomorrow"
                            android:textSize="11sp"
                            app:chipCornerRadius="12dp" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/task_due_next_week"
                            style="@style/Widget.Material3.Chip.Assist"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:minHeight="36dp"
                            android:text="@string/task_due_next_week"
                            android:textSize="11sp"
                            app:chipCornerRadius="12dp" />
                    </com.google.android.material.chip.ChipGroup>
                </HorizontalScrollView>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.FamilyHub.Form.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:cardBackgroundColor="@color/fh_primary_container"
            app:cardCornerRadius="12dp"
            app:strokeColor="@color/fh_primary">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="7dp">

                <TextView
                    style="@style/TextAppearance.FamilyHub.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="@string/family_tasks_editor_planning"
                    android:textColor="@color/fh_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.FamilyHub.FloatingCompact.Dropdown"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="3dp"
                        android:layout_weight="1"
                        android:hint="@string/family_tasks_priority"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/task_priority_input"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:gravity="center_vertical"
                            android:includeFontPadding="false"
                            android:inputType="none"
                            android:maxLines="1"
                            android:paddingStart="10dp"
                            android:paddingEnd="8dp"
                            android:textSize="12sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.FamilyHub.FloatingCompact.Dropdown"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3dp"
                        android:layout_weight="1"
                        android:hint="@string/family_tasks_repeat"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/task_repeat_input"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:gravity="center_vertical"
                            android:includeFontPadding="false"
                            android:inputType="none"
                            android:maxLines="1"
                            android:paddingStart="10dp"
                            android:paddingEnd="8dp"
                            android:textSize="12sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:orientation="horizontal">

                    <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.FamilyHub.FloatingCompact.Dropdown"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="3dp"
                        android:layout_weight="0.9"
                        android:hint="@string/family_tasks_assign"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/task_member_input"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:ellipsize="end"
                            android:gravity="center_vertical"
                            android:includeFontPadding="false"
                            android:inputType="none"
                            android:maxLines="1"
                            android:paddingStart="10dp"
                            android:paddingEnd="8dp"
                            android:textSize="12sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.FamilyHub.FloatingCompact.Date"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3dp"
                        android:layout_weight="1.1"
                        android:hint="@string/family_tasks_due"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/task_due_input"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:clickable="true"
                            android:cursorVisible="false"
                            android:focusable="false"
                            android:gravity="center_vertical"
                            android:includeFontPadding="false"
                            android:inputType="none"
                            android:maxLines="1"
                            android:paddingEnd="4dp"
                            android:textAlignment="viewStart"
                            android:textSize="11.5sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.FamilyHub.Form.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:cardBackgroundColor="@color/fh_success_container"
            app:cardCornerRadius="12dp"
            app:strokeColor="@color/fh_success">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="7dp"
                android:paddingTop="5dp"
                android:paddingEnd="7dp"
                android:paddingBottom="7dp">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/task_grocery_switch"
                    style="@style/Widget.FamilyHub.FloatingCompact.Switch"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="@string/family_tasks_add_to_grocery"
                    android:textSize="11.5sp" />

                <LinearLayout
                    android:id="@+id/task_grocery_options"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.FamilyHub.FloatingCompact.Dropdown"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="3dp"
                        android:layout_weight="1"
                        android:hint="@string/family_tasks_grocery_category"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/task_grocery_category_input"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:ellipsize="end"
                            android:gravity="center_vertical"
                            android:includeFontPadding="false"
                            android:inputType="none"
                            android:maxLines="1"
                            android:paddingStart="10dp"
                            android:paddingEnd="8dp"
                            android:textSize="12sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.FamilyHub.FloatingCompact.Dropdown"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3dp"
                        android:layout_weight="1"
                        android:hint="@string/family_tasks_grocery_list"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/task_grocery_list_input"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:gravity="center_vertical"
                            android:includeFontPadding="false"
                            android:inputType="none"
                            android:maxLines="1"
                            android:paddingStart="10dp"
                            android:paddingEnd="8dp"
                            android:textSize="12sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.FamilyHub.Form.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:cardBackgroundColor="@color/fh_form_surface_tint"
            app:cardCornerRadius="12dp"
            app:strokeColor="@color/fh_form_accent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="7dp">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/task_reminder_switch"
                    style="@style/Widget.FamilyHub.FloatingCompact.Switch"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:checked="true"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/family_tasks_remind"
                    android:textSize="11.5sp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/task_reminder_lead_layout"
                    style="@style/Widget.FamilyHub.FloatingCompact.Dropdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:hint="@string/family_tasks_reminder_time"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/task_reminder_lead_input"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:gravity="center_vertical"
                        android:includeFontPadding="false"
                        android:inputType="none"
                        android:maxLines="1"
                        android:paddingStart="10dp"
                        android:paddingEnd="8dp"
                        android:textAlignment="viewStart"
                        android:textSize="11.5sp" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.FamilyHub.Form.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:cardBackgroundColor="@color/fh_surface_container"
            app:cardCornerRadius="12dp"
            app:strokeColor="@color/fh_outline_variant">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="7dp">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.FamilyHub.FloatingCompact.Field"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/family_tasks_notes"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/task_notes_input"
                        android:layout_width="match_parent"
                        android:layout_height="62dp"
                        android:gravity="top|start"
                        android:includeFontPadding="false"
                        android:inputType="textCapSentences|textMultiLine"
                        android:maxLines="3"
                        android:minLines="1"
                        android:paddingTop="10dp"
                        android:textSize="12sp" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cancel_task_button"
                style="@style/Widget.FamilyHub.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:minHeight="40dp"
                android:text="@string/cancel"
                android:textSize="11.5sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/save_task_button"
                style="@style/Widget.FamilyHub.FloatingCompact.PrimaryAction"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="3dp"
                android:layout_weight="1.25"
                android:minHeight="40dp"
                android:maxLines="1"
                android:text="@string/family_tasks_save"
                android:textSize="11.5sp"
                app:icon="@drawable/ic_family_task"
                app:iconSize="16dp" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
