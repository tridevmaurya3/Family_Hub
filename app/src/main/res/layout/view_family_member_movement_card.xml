<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.FamilyHub.Card.Data"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/card_spacing"
    android:layout_marginBottom="@dimen/space_24"
    app:cardBackgroundColor="@color/fh_module_planner_container">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/card_padding">
        <TextView style="@style/TextAppearance.FamilyHub.CardTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/family_member_detail_movement_section" />
        <TextView android:id="@+id/tvMemberDetailMovement" style="@style/TextAppearance.FamilyHub.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_12" />
        <TextView android:id="@+id/tvMemberDetailSpeed" style="@style/TextAppearance.FamilyHub.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_8" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
