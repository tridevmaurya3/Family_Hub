<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.google.android.material.button.MaterialButton android:id="@+id/reminder_toggle"
        style="@style/Widget.FamilyHub.FloatingCompact.Action"
        android:layout_width="match_parent" android:layout_height="40dp"
        android:text="@string/task_reminder_options" />
    <com.google.android.material.button.MaterialButton android:id="@+id/reminder_notification_access"
        style="@style/Widget.FamilyHub.FloatingCompact.Action"
        android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginTop="4dp"
        android:text="@string/task_reminder_notification_access" android:visibility="gone" />
    <com.google.android.material.button.MaterialButton android:id="@+id/reminder_exact_access"
        style="@style/Widget.FamilyHub.FloatingCompact.Action"
        android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginTop="4dp"
        android:text="@string/task_reminder_exact_access" android:visibility="gone" />
    <com.google.android.material.card.MaterialCardView android:id="@+id/reminder_details"
        style="@style/Widget.FamilyHub.Form.Section"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"
        android:visibility="gone" app:cardBackgroundColor="@color/fh_surface_container"
        app:cardCornerRadius="12dp" app:strokeColor="@color/fh_outline_variant">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="7dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal">
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/reminder_lead_layout"
                    style="@style/Widget.FamilyHub.FloatingCompact.Dropdown"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:layout_marginEnd="3dp" android:hint="@string/family_tasks_reminder_time">
                    <com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/reminder_lead_input"
                        android:layout_width="match_parent" android:layout_height="44dp" android:inputType="none"
                        android:maxLines="1" android:ellipsize="end" android:textSize="11.5sp"
                        android:gravity="center_vertical" android:includeFontPadding="false"
                        android:paddingStart="10dp" android:paddingEnd="8dp" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/reminder_mode_layout"
                    style="@style/Widget.FamilyHub.FloatingCompact.Dropdown"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:layout_marginStart="3dp" android:hint="@string/task_reminder_alert_type">
                    <com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/reminder_mode_input"
                        android:layout_width="match_parent" android:layout_height="44dp" android:inputType="none"
                        android:maxLines="1" android:ellipsize="end" android:textSize="11.5sp"
                        android:gravity="center_vertical" android:includeFontPadding="false"
                        android:paddingStart="10dp" android:paddingEnd="8dp" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
            <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/reminder_followup"
                style="@style/Widget.FamilyHub.FloatingCompact.Switch"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="44dp"
                android:text="@string/task_reminder_followup" android:textSize="11.5sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/task_reminder_device_options" android:textSize="10sp"
                android:textColor="@color/fh_text_secondary" android:paddingVertical="4dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton android:id="@+id/reminder_permissions"
                    style="@style/Widget.FamilyHub.FloatingCompact.Action"
                    android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                    android:layout_marginEnd="3dp" android:text="@string/task_reminder_permissions" android:maxLines="2" />
                <com.google.android.material.button.MaterialButton android:id="@+id/reminder_test"
                    style="@style/Widget.FamilyHub.FloatingCompact.Action"
                    android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                    android:layout_marginStart="3dp" android:text="@string/task_reminder_test" android:maxLines="2" />
            </LinearLayout>
            <TextView android:id="@+id/reminder_permission_detail"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone"
                android:text="@string/task_reminder_exact_detail" android:textSize="11sp"
                android:textColor="@color/fh_text_secondary" android:paddingTop="4dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</merge>
