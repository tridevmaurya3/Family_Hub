<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fh_background"
    android:paddingStart="@dimen/screen_padding_horizontal"
    android:paddingTop="@dimen/compact_page_top_padding"
    android:paddingEnd="@dimen/screen_padding_horizontal">

    <TextView
        android:id="@+id/tvFamilyLiveTitle"
        style="@style/TextAppearance.FamilyHub.Heading"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/family_live"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvFamilyLiveSubtitle"
        style="@style/TextAppearance.FamilyHub.Body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_4"
        android:text="@string/family_live_subtitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvFamilyLiveTitle" />

    <com.tridev.familyhub.feature.familylive.view.FamilyLiveSummaryView
        android:id="@+id/summaryCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/family_live_section_gap"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvFamilyLiveSubtitle" />

    <TextView
        android:id="@+id/tvMemberCount"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/summaryCard" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/locationSharingCard"
        style="@style/Widget.FamilyHub.Card.Flat"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/family_live_section_gap"
        app:cardBackgroundColor="@color/fh_module_grocery_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/summaryCard">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/family_live_card_padding">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_12"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvSharingStatus"
                    style="@style/TextAppearance.FamilyHub.SectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/family_live_sharing_off" />

                <TextView
                    android:id="@+id/tvSharingDetail"
                    style="@style/TextAppearance.FamilyHub.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:maxLines="1"
                    android:text="@string/family_live_sharing_off_detail" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonLocationSharing"
                style="@style/Widget.FamilyHub.Button.Tonal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_target_min"
                android:text="@string/family_live_start_sharing"
                android:textColor="@color/fh_module_grocery"
                app:backgroundTint="@color/fh_surface" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/viewToggle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/family_live_section_gap"
        app:checkedButton="@id/buttonListView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/locationSharingCard"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonListView"
            style="@style/Widget.FamilyHub.Button.Tonal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:checked="true"
            android:text="@string/family_live_list_view"
            android:textColor="@color/fh_module_family"
            app:backgroundTint="@color/fh_module_family_container" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonMapView"
            style="@style/Widget.FamilyHub.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/family_live_map_view"
            android:textColor="@color/fh_module_documents"
            app:backgroundTint="@color/fh_module_documents_container" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/familyLiveSearchLayout"
        style="@style/Widget.FamilyHub.TextInputLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/family_live_section_gap"
        android:hint="@string/family_live_search_hint"
        app:endIconMode="clear_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/viewToggle"
        app:startIconDrawable="@drawable/ic_search"
        app:startIconTint="@color/fh_module_family">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/familyLiveSearchInput"
            style="@style/TextAppearance.FamilyHub.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:id="@+id/familyLiveFilterRow"
        android:layout_width="0dp"
        android:layout_height="@dimen/touch_target_min"
        android:layout_marginTop="@dimen/space_4"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/familyLiveSearchLayout">

        <HorizontalScrollView
            android:id="@+id/familyLiveFilterScroll"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="false"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/familyLiveFilterGroup"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                app:checkedChip="@id/chipFamilyLiveAll"
                app:chipSpacingHorizontal="@dimen/space_6"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFamilyLiveAll"
                    style="@style/Widget.FamilyHub.StatusChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="@string/family_live_filter_all"
                    app:chipBackgroundColor="@color/fh_module_family_container"
                    app:chipMinHeight="@dimen/family_live_chip_height" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFamilyLiveLive"
                    style="@style/Widget.FamilyHub.StatusChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="@string/family_live_filter_live"
                    app:chipBackgroundColor="@color/fh_module_finance_container"
                    app:chipMinHeight="@dimen/family_live_chip_height" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFamilyLiveStale"
                    style="@style/Widget.FamilyHub.StatusChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="@string/family_live_filter_stale"
                    app:chipBackgroundColor="@color/fh_module_reminders_container"
                    app:chipMinHeight="@dimen/family_live_chip_height" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFamilyLiveAttention"
                    style="@style/Widget.FamilyHub.StatusChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="@string/family_live_filter_attention"
                    app:chipBackgroundColor="@color/fh_error_container"
                    app:chipMinHeight="@dimen/family_live_chip_height" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonRefreshList"
            style="@style/Widget.FamilyHub.Button.Tonal"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_target_min"
            android:layout_marginStart="@dimen/space_6"
            android:minWidth="0dp"
            android:text="@string/family_live_refresh"
            android:textColor="@color/fh_module_family"
            app:backgroundTint="@color/fh_module_family_container" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/listHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/family_live_section_gap"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/familyLiveFilterRow">

        <TextView
            android:id="@+id/tvListHeaderTitle"
            style="@style/TextAppearance.FamilyHub.SectionTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/family_live_members_title" />

        <TextView
            android:id="@+id/tvListSortState"
            style="@style/TextAppearance.FamilyHub.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_8"
            android:background="@drawable/bg_status_pill"
            android:paddingStart="@dimen/space_8"
            android:paddingTop="@dimen/space_4"
            android:paddingEnd="@dimen/space_8"
            android:paddingBottom="@dimen/space_4"
            android:text="@string/family_live_sort_priority"
            android:textColor="@color/fh_module_family"
            android:textStyle="bold" />

    </LinearLayout>

    <FrameLayout
        android:id="@+id/mapContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_8"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/viewToggle">

        <FrameLayout
            android:id="@+id/mapHost"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ProgressBar
            android:id="@+id/mapLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:contentDescription="@string/family_live_map_loading" />

        <TextView
            android:id="@+id/mapError"
            style="@style/TextAppearance.FamilyHub.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@color/fh_surface"
            android:gravity="center"
            android:padding="@dimen/card_padding"
            android:text="@string/family_live_map_no_locations"
            android:textAlignment="center"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|bottom"
            android:layout_margin="@dimen/space_12"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonMapType"
                style="@style/Widget.FamilyHub.Button.Tonal"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_target_min"
                android:text="@string/family_live_map_type_satellite" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonRecenter"
                style="@style/Widget.FamilyHub.Button.Tonal"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_target_min"
                android:layout_marginTop="@dimen/space_8"
                android:text="@string/family_live_map_recenter" />
        </LinearLayout>
    </FrameLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/familyLiveRefresh"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/listHeader">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerFamilyLive"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="@dimen/space_6"
                android:paddingBottom="@dimen/space_24" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/family_live_empty_state"
                style="@style/Widget.FamilyHub.Card.Flat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:visibility="gone"
                app:cardBackgroundColor="@color/fh_module_family_container"
                app:strokeColor="@color/fh_module_family">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/compact_empty_state_padding">

                    <ImageView
                        android:layout_width="@dimen/compact_empty_state_icon_size"
                        android:layout_height="@dimen/compact_empty_state_icon_size"
                        android:background="@drawable/bg_placeholder_icon"
                        android:contentDescription="@null"
                        android:padding="@dimen/compact_empty_state_icon_padding"
                        android:src="@drawable/ic_family"
                        app:tint="@color/fh_module_family" />

                    <TextView
                        style="@style/TextAppearance.FamilyHub.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/compact_section_spacing"
                        android:gravity="center"
                        android:text="@string/family_live_empty_title" />

                    <TextView
                        style="@style/TextAppearance.FamilyHub.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:gravity="center"
                        android:text="@string/family_live_empty_detail"
                        android:textAlignment="center" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </FrameLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
