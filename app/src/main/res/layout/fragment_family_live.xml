<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_page_three_tone">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/familyLiveAppBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_page_three_tone"
        android:elevation="0dp"
        app:elevation="0dp"
        app:liftOnScroll="true">

        <LinearLayout
            android:id="@+id/familyLiveCollapsibleHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/family_live_responsive_horizontal_padding"
            android:paddingTop="@dimen/family_live_responsive_top_padding"
            android:paddingEnd="@dimen/family_live_responsive_horizontal_padding"
            android:paddingBottom="@dimen/family_live_responsive_header_bottom_padding"
            app:layout_scrollFlags="scroll|enterAlways">

            <TextView
                android:id="@+id/tvFamilyLiveTitle"
                style="@style/TextAppearance.FamilyHub.Heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/family_live"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvFamilyLiveSubtitle"
                style="@style/TextAppearance.FamilyHub.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/family_live_subtitle"
                android:visibility="gone" />

            <com.tridev.familyhub.feature.familylive.view.FamilyLiveSummaryView
                android:id="@+id/summaryCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp" />

            <TextView
                android:id="@+id/tvMemberCount"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/locationSharingCard"
                style="@style/Widget.FamilyHub.Card.Flat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/family_live_responsive_section_gap"
                app:cardBackgroundColor="@color/fh_surface"
                app:strokeColor="@color/fh_outline">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/family_live_sharing_padding">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="@dimen/family_live_sharing_icon_container"
                            android:layout_height="@dimen/family_live_sharing_icon_container"
                            app:cardBackgroundColor="@color/fh_primary_container"
                            app:cardCornerRadius="@dimen/radius_12"
                            app:cardElevation="0dp"
                            app:strokeColor="@color/fh_outline_variant"
                            app:strokeWidth="@dimen/border_width">

                            <ImageView
                                android:layout_width="@dimen/family_live_sharing_icon_size"
                                android:layout_height="@dimen/family_live_sharing_icon_size"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_fh_location_pin"
                                app:tint="@color/fh_primary" />

                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_8"
                            android:layout_marginEnd="@dimen/space_6"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/TextAppearance.FamilyHub.Overline"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="@string/family_live_sharing_overline"
                                android:textColor="@color/fh_primary"
                                android:textSize="9sp" />

                            <TextView
                                android:id="@+id/tvSharingStatus"
                                style="@style/TextAppearance.FamilyHub.SectionTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_2"
                                android:ellipsize="end"
                                android:maxLines="2"
                                android:text="@string/family_live_sharing_off"
                                android:textColor="@color/fh_on_surface"
                                android:textSize="15sp" />

                            <TextView
                                android:id="@+id/tvSharingDetail"
                                style="@style/TextAppearance.FamilyHub.Caption"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_2"
                                android:ellipsize="end"
                                android:maxLines="2"
                                android:text="@string/family_live_sharing_off_detail"
                                android:textColor="@color/fh_text_secondary"
                                android:textSize="10sp" />

                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/buttonLocationSharing"
                            style="@style/Widget.FamilyHub.Button.Tonal"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:minWidth="0dp"
                            android:paddingStart="@dimen/space_10"
                            android:paddingEnd="@dimen/space_10"
                            android:text="@string/family_live_start_sharing"
                            android:textColor="@color/fh_primary"
                            android:textSize="11sp"
                            app:backgroundTint="@color/fh_primary_container"
                            app:icon="@drawable/ic_fh_location_pin"
                            app:iconGravity="textStart"
                            app:iconPadding="@dimen/space_4"
                            app:iconSize="16dp"
                            app:iconTint="@color/fh_primary" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_6"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_fh_shield_check"
                            app:tint="@color/fh_primary" />

                        <TextView
                            style="@style/TextAppearance.FamilyHub.Caption"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_6"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/family_live_sharing_privacy"
                            android:textColor="@color/fh_text_secondary"
                            android:textSize="10sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/buttonExtendSharing"
                            style="@style/Widget.FamilyHub.Button.Text"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:minWidth="0dp"
                            android:text="@string/family_live_extend_sharing"
                            android:textColor="@color/fh_primary"
                            android:textSize="10sp"
                            android:visibility="gone"
                            app:icon="@drawable/ic_add"
                            app:iconGravity="textStart"
                            app:iconPadding="@dimen/space_2"
                            app:iconSize="14dp"
                            app:iconTint="@color/fh_primary" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/buttonManageViewers"
                            style="@style/Widget.FamilyHub.Button.Text"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:minWidth="0dp"
                            android:text="@string/family_live_manage_viewers"
                            android:textColor="@color/fh_primary"
                            android:textSize="10sp"
                            app:icon="@drawable/ic_fh_shield_check"
                            app:iconGravity="textStart"
                            app:iconPadding="@dimen/space_4"
                            app:iconSize="15dp"
                            app:iconTint="@color/fh_primary" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvSharingActivity"
                        style="@style/TextAppearance.FamilyHub.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/family_live_sharing_activity_none"
                        android:textColor="@color/fh_text_secondary"
                        android:textSize="9sp" />

                    <TextView
                        android:id="@+id/tvSharingHealth"
                        style="@style/TextAppearance.FamilyHub.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:maxLines="2"
                        android:text="@string/family_live_health_checking"
                        android:textColor="@color/fh_text_secondary"
                        android:textSize="9sp" />

                    <TextView
                        android:id="@+id/tvSharingSync"
                        style="@style/TextAppearance.FamilyHub.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:maxLines="2"
                        android:text="@string/family_live_sync_checking"
                        android:textColor="@color/fh_text_secondary"
                        android:textSize="9sp" />

                    <TextView
                        android:id="@+id/tvViewerActivity"
                        style="@style/TextAppearance.FamilyHub.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:maxLines="2"
                        android:text="@string/family_live_viewer_activity_none"
                        android:textColor="@color/fh_text_secondary"
                        android:textSize="9sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonEmergencyPrivacyStop"
                        style="@style/Widget.FamilyHub.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_gravity="end"
                        android:layout_marginTop="@dimen/space_2"
                        android:minWidth="0dp"
                        android:text="@string/family_live_emergency_privacy_stop"
                        android:textColor="@color/fh_error"
                        android:textSize="10sp"
                        android:visibility="gone" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/familyLivePinnedControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_page_three_tone"
            android:orientation="vertical"
            android:paddingStart="@dimen/family_live_responsive_horizontal_padding"
            android:paddingEnd="@dimen/family_live_responsive_horizontal_padding"
            android:paddingBottom="@dimen/family_live_responsive_header_bottom_padding">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/controlsCard"
                style="@style/Widget.FamilyHub.Card.Flat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/fh_surface"
                app:strokeColor="@color/fh_outline">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/family_live_controls_padding">

                    <TextView
                        style="@style/TextAppearance.FamilyHub.SectionTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/family_live_view_title"
                        android:textSize="15sp" />

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/viewToggle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        app:checkedButton="@id/buttonListView"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/buttonListView"
                            style="@style/Widget.FamilyHub.Button.Tonal"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:checked="true"
                            android:text="@string/family_live_list_view"
                            android:textColor="@color/fh_module_family"
                            android:textSize="11sp"
                            app:backgroundTint="@color/fh_module_family_container"
                            app:icon="@drawable/ic_fh_list_view"
                            app:iconGravity="textStart"
                            app:iconPadding="@dimen/space_6"
                            app:iconSize="17dp"
                            app:iconTint="@color/fh_module_family" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/buttonMapView"
                            style="@style/Widget.FamilyHub.Button.Outlined"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:text="@string/family_live_map_view"
                            android:textColor="@color/fh_module_documents"
                            android:textSize="11sp"
                            app:backgroundTint="@color/fh_module_documents_container"
                            app:icon="@drawable/ic_fh_map_view"
                            app:iconGravity="textStart"
                            app:iconPadding="@dimen/space_6"
                            app:iconSize="17dp"
                            app:iconTint="@color/fh_module_documents" />

                    </com.google.android.material.button.MaterialButtonToggleGroup>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/familyLiveSearchLayout"
                style="@style/Widget.FamilyHub.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/family_live_responsive_section_gap"
                android:hint="@string/family_live_search_hint"
                app:endIconMode="clear_text"
                app:startIconDrawable="@drawable/ic_search"
                app:startIconTint="@color/fh_module_family">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/familyLiveSearchInput"
                    style="@style/TextAppearance.FamilyHub.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:id="@+id/familyLiveFilterRow"
                android:layout_width="match_parent"
                android:layout_height="@dimen/family_live_filter_row_height"
                android:layout_marginTop="@dimen/space_2"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <HorizontalScrollView
                    android:id="@+id/familyLiveFilterScroll"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:fillViewport="false"
                    android:scrollbars="none">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/familyLiveFilterGroup"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        app:checkedChip="@id/chipFamilyLiveAll"
                        app:chipSpacingHorizontal="@dimen/space_4"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipFamilyLiveAll"
                            style="@style/Widget.FamilyHub.StatusChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checkable="true"
                            android:text="@string/family_live_filter_all"
                            android:textSize="10sp"
                            app:chipBackgroundColor="@color/fh_module_family_container"
                            app:chipMinHeight="@dimen/family_live_chip_height" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipFamilyLiveLive"
                            style="@style/Widget.FamilyHub.StatusChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checkable="true"
                            android:text="@string/family_live_filter_live"
                            android:textSize="10sp"
                            app:chipBackgroundColor="@color/fh_module_finance_container"
                            app:chipMinHeight="@dimen/family_live_chip_height" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipFamilyLiveStale"
                            style="@style/Widget.FamilyHub.StatusChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checkable="true"
                            android:text="@string/family_live_filter_stale"
                            android:textSize="10sp"
                            app:chipBackgroundColor="@color/fh_module_reminders_container"
                            app:chipMinHeight="@dimen/family_live_chip_height" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipFamilyLiveAttention"
                            style="@style/Widget.FamilyHub.StatusChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checkable="true"
                            android:text="@string/family_live_filter_attention"
                            android:textSize="10sp"
                            app:chipBackgroundColor="@color/fh_error_container"
                            app:chipMinHeight="@dimen/family_live_chip_height" />

                    </com.google.android.material.chip.ChipGroup>
                </HorizontalScrollView>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonRefreshList"
                    style="@style/Widget.FamilyHub.Button.Tonal"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="@dimen/space_4"
                    android:contentDescription="@string/family_live_refresh_content_description"
                    android:minWidth="44dp"
                    android:padding="0dp"
                    android:text=""
                    app:backgroundTint="@color/fh_module_family_container"
                    app:icon="@drawable/ic_fh_refresh"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="18dp"
                    app:iconTint="@color/fh_module_family" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/listHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvListHeaderTitle"
                    style="@style/TextAppearance.FamilyHub.SectionTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/family_live_members_title"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvListSortState"
                    style="@style/TextAppearance.FamilyHub.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_6"
                    android:background="@drawable/bg_status_pill"
                    android:paddingStart="@dimen/space_6"
                    android:paddingTop="@dimen/space_4"
                    android:paddingEnd="@dimen/space_6"
                    android:paddingBottom="@dimen/space_4"
                    android:text="@string/family_live_sort_priority"
                    android:textColor="@color/fh_module_family"
                    android:textSize="10sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/familyLiveRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/family_live_responsive_horizontal_padding"
        android:layout_marginEnd="@dimen/family_live_responsive_horizontal_padding"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <FrameLayout
            android:id="@+id/familyLiveContentFrame"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:animateLayoutChanges="true">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerFamilyLive"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="true"
                android:paddingTop="@dimen/family_live_list_top_padding"
                android:paddingBottom="@dimen/family_live_list_bottom_padding" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/family_live_loading_state"
                style="@style/Widget.FamilyHub.Card.Flat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                app:cardBackgroundColor="@color/fh_surface"
                app:strokeColor="@color/fh_outline">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/compact_empty_state_padding">

                    <ProgressBar
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:contentDescription="@string/family_live_loading_content_description"
                        android:indeterminateTint="@color/fh_module_family" />

                    <TextView
                        style="@style/TextAppearance.FamilyHub.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_12"
                        android:gravity="center"
                        android:text="@string/family_live_loading_title" />

                    <TextView
                        style="@style/TextAppearance.FamilyHub.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_6"
                        android:gravity="center"
                        android:text="@string/family_live_loading_detail"
                        android:textAlignment="center"
                        android:textColor="@color/fh_text_secondary" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/family_live_empty_state"
                style="@style/Widget.FamilyHub.Card.Flat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:visibility="gone"
                app:cardBackgroundColor="@color/fh_surface"
                app:strokeColor="@color/fh_outline">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/compact_empty_state_padding">

                    <ImageView
                        android:layout_width="@dimen/compact_empty_state_icon_size"
                        android:layout_height="@dimen/compact_empty_state_icon_size"
                        android:background="@drawable/bg_placeholder_icon"
                        android:contentDescription="@null"
                        android:padding="@dimen/compact_empty_state_icon_padding"
                        android:src="@drawable/ic_family"
                        app:tint="@color/fh_module_family" />

                    <TextView
                        android:id="@+id/tvFamilyLiveEmptyTitle"
                        style="@style/TextAppearance.FamilyHub.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/compact_section_spacing"
                        android:gravity="center"
                        android:text="@string/family_live_empty_title" />

                    <TextView
                        android:id="@+id/tvFamilyLiveEmptyDetail"
                        style="@style/TextAppearance.FamilyHub.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:gravity="center"
                        android:text="@string/family_live_empty_detail"
                        android:textAlignment="center"
                        android:textColor="@color/fh_text_secondary" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </FrameLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <FrameLayout
        android:id="@+id/mapContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/family_live_responsive_horizontal_padding"
        android:layout_marginEnd="@dimen/family_live_responsive_horizontal_padding"
        android:visibility="gone"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <FrameLayout
            android:id="@+id/mapHost"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ProgressBar
            android:id="@+id/mapLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:contentDescription="@string/family_live_map_loading" />

        <TextView
            android:id="@+id/mapError"
            style="@style/TextAppearance.FamilyHub.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@color/fh_surface"
            android:gravity="center"
            android:padding="@dimen/card_padding"
            android:text="@string/family_live_map_no_locations"
            android:textAlignment="center"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|bottom"
            android:layout_margin="@dimen/space_12"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonMapType"
                style="@style/Widget.FamilyHub.Button.Tonal"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_target_min"
                android:text="@string/family_live_map_type_satellite" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonRecenter"
                style="@style/Widget.FamilyHub.Button.Tonal"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_target_min"
                android:layout_marginTop="@dimen/space_8"
                android:text="@string/family_live_map_recenter" />

        </LinearLayout>
    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
