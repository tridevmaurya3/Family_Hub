<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fh_background"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding_horizontal"
        android:paddingTop="@dimen/space_16"
        android:paddingEnd="@dimen/screen_padding_horizontal"
        android:paddingBottom="@dimen/space_32">

        <!-- Compact Fluent dashboard header -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/dashboard_header_card"
            style="@style/Widget.FamilyHub.Card.Flat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/fh_surface"
            app:strokeColor="@color/fh_outline">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/space_10">

                <ImageButton
                    android:id="@+id/dashboard_menu_button"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="@dimen/space_8"
                    android:background="@drawable/bg_icon_button"
                    android:contentDescription="@string/dashboard_feature_menu_content_description"
                    android:padding="11dp"
                    android:src="@drawable/ic_menu_hamburger"
                    app:tint="@color/fh_primary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/dashboard_greeting"
                        style="@style/TextAppearance.FamilyHub.Heading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dashboard_greeting"
                        android:textColor="@color/fh_on_surface"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/dashboard_current_date"
                        style="@style/TextAppearance.FamilyHub.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:text="@string/dashboard_intro"
                        android:textColor="@color/fh_on_surface_variant"
                        android:textSize="12sp" />
                </LinearLayout>

                <FrameLayout android:layout_width="@dimen/touch_target_min" android:layout_height="@dimen/touch_target_min">
                    <ImageButton
                        android:id="@+id/notification_button"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_icon_button"
                        android:contentDescription="@string/content_description_notifications"
                        android:padding="@dimen/space_12"
                        android:src="@drawable/ic_bell"
                        app:tint="@color/fh_on_surface" />
                    <TextView android:id="@+id/dashboard_notification_badge" android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="top|end" android:background="@drawable/bg_status_pill" android:gravity="center" android:text="0" android:textColor="@color/fh_error" android:textSize="9sp" android:textStyle="bold" android:visibility="gone" />
                </FrameLayout>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/dashboard_profile_card"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="4dp"
                    android:clickable="true"
                    android:contentDescription="@string/dashboard_profile_content_description"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="@color/fh_primary_container"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/fh_outline"
                    app:strokeWidth="1dp">

                    <ImageView
                        android:id="@+id/dashboard_profile_avatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/dashboard_profile_content_description"
                        android:padding="9dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_profile_person"
                        app:tint="@color/fh_primary" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Reusable dashboard search -->
        <com.tridev.familyhub.core.ui.search.SearchBarView
            android:id="@+id/dashboard_search_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12" />

        <!-- Reusable Family Hub Hero Card -->
        <com.tridev.familyhub.core.ui.cards.HeroCardView
            android:id="@+id/dashboard_hero_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12" />

        <ProgressBar
            android:id="@+id/dashboard_loading"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_8"
            android:contentDescription="@string/dashboard_loading"
            android:visibility="gone" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/dashboard_error_card"
            style="@style/Widget.FamilyHub.Card.Flat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:visibility="gone"
            app:cardBackgroundColor="@color/fh_surface_container"
            app:strokeColor="@color/fh_error">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/space_8">

                <TextView
                    android:id="@+id/dashboard_error_text"
                    style="@style/TextAppearance.FamilyHub.Caption"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/dashboard_load_error"
                    android:textColor="@color/fh_error"
                    android:textSize="11sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/dashboard_retry"
                    style="@style/Widget.FamilyHub.Button.Action"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/touch_target_min"
                    android:text="@string/dashboard_retry"
                    android:textSize="11sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/dashboard_priority_card"
            style="@style/Widget.FamilyHub.Card.Flat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            app:cardBackgroundColor="@color/fh_surface"
            app:strokeColor="@color/fh_outline">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/space_12">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView style="@style/TextAppearance.FamilyHub.SectionTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/dashboard_priority_title" android:textSize="15sp" />
                        <TextView android:id="@+id/dashboard_last_updated" style="@style/TextAppearance.FamilyHub.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/dashboard_updating" />
                    </LinearLayout>
                    <com.google.android.material.button.MaterialButton android:id="@+id/dashboard_refresh" style="@style/Widget.Material3.Button.IconButton" android:layout_width="44dp" android:layout_height="44dp" android:contentDescription="@string/dashboard_refresh" app:icon="@drawable/ic_family_map_refresh" app:iconTint="@color/fh_primary" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_8" android:baselineAligned="false" android:orientation="horizontal">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/bg_status_pill" android:gravity="center" android:orientation="vertical" android:padding="@dimen/space_8">
                        <TextView android:id="@+id/dashboard_pending_value" style="@style/TextAppearance.FamilyHub.SectionTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/fh_primary" />
                        <TextView style="@style/TextAppearance.FamilyHub.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/dashboard_pending" />
                    </LinearLayout>
                    <View android:layout_width="6dp" android:layout_height="1dp" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/bg_status_pill" android:gravity="center" android:orientation="vertical" android:padding="@dimen/space_8">
                        <TextView android:id="@+id/dashboard_upcoming_value" style="@style/TextAppearance.FamilyHub.SectionTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/fh_warning" />
                        <TextView style="@style/TextAppearance.FamilyHub.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/dashboard_upcoming" />
                    </LinearLayout>
                    <View android:layout_width="6dp" android:layout_height="1dp" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/bg_status_pill" android:gravity="center" android:orientation="vertical" android:padding="@dimen/space_8">
                        <TextView android:id="@+id/dashboard_urgent_value" style="@style/TextAppearance.FamilyHub.SectionTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/fh_error" />
                        <TextView style="@style/TextAppearance.FamilyHub.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/dashboard_urgent" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/dashboard_empty_state"
            style="@style/TextAppearance.FamilyHub.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:background="@drawable/bg_status_pill"
            android:gravity="center"
            android:padding="@dimen/space_12"
            android:text="@string/dashboard_empty_state"
            android:visibility="gone" />

        <!-- Live action center -->
        <TextView
            style="@style/TextAppearance.FamilyHub.SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_20"
            android:text="@string/dashboard_action_center"
            android:textColor="@color/fh_on_surface"
            android:textSize="16sp" />

        <TextView
            style="@style/TextAppearance.FamilyHub.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:text="@string/dashboard_action_center_detail"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="104dp"
            android:layout_marginTop="@dimen/space_8"
            android:orientation="horizontal">

            <com.tridev.familyhub.core.ui.cards.ActionCardView
                android:id="@+id/action_planner"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="@dimen/space_4"
                android:layout_weight="1" />

            <com.tridev.familyhub.core.ui.cards.ActionCardView
                android:id="@+id/action_grocery"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/space_4"
                android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="104dp"
            android:layout_marginTop="@dimen/space_8"
            android:orientation="horizontal">

            <com.tridev.familyhub.core.ui.cards.ActionCardView
                android:id="@+id/action_documents"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="@dimen/space_4"
                android:layout_weight="1" />

            <com.tridev.familyhub.core.ui.cards.ActionCardView
                android:id="@+id/action_vehicles"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/space_4"
                android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="104dp"
            android:layout_marginTop="@dimen/space_8"
            android:orientation="horizontal">

            <com.tridev.familyhub.core.ui.cards.ActionCardView
                android:id="@+id/action_notes"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="@dimen/space_4"
                android:layout_weight="1" />

            <com.tridev.familyhub.core.ui.cards.ActionCardView
                android:id="@+id/action_family_live"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/space_4"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- Retained IDs are hidden for ViewBinding compatibility. -->
        <LinearLayout
            android:id="@+id/legacy_quick_row_one"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/quick_family"
                style="@style/Widget.FamilyHub.Card.Flat"
                android:layout_width="0dp"
                android:layout_height="124dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="@color/fh_module_family_container"
                app:strokeColor="@color/fh_module_family">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:contentDescription="@string/family_members"
                        android:src="@drawable/ic_family"
                        app:tint="@color/fh_primary" />

                    <TextView
                        style="@style/TextAppearance.FamilyHub.CardTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_12"
                        android:gravity="center"
                        android:text="@string/family_members"
                        android:textColor="@color/fh_on_surface" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <View
                android:layout_width="@dimen/space_12"
                android:layout_height="0dp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/quick_reminder"
                style="@style/Widget.FamilyHub.Card.Flat"
                android:layout_width="0dp"
                android:layout_height="124dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="@color/fh_module_reminders_container"
                app:strokeColor="@color/fh_module_reminders">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:contentDescription="@string/add_reminder"
                        android:src="@drawable/ic_reminder"
                        app:tint="@color/fh_tertiary" />

                    <TextView
                        style="@style/TextAppearance.FamilyHub.CardTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_12"
                        android:gravity="center"
                        android:text="@string/add_reminder"
                        android:textColor="@color/fh_on_surface" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- Quick actions second row -->
        <LinearLayout
            android:id="@+id/legacy_quick_row_two"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/quick_expense"
                style="@style/Widget.FamilyHub.Card.Flat"
                android:layout_width="0dp"
                android:layout_height="124dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="@color/fh_module_finance_container"
                app:strokeColor="@color/fh_module_finance">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:contentDescription="@string/add_expense"
                        android:src="@drawable/ic_wallet"
                        app:tint="@color/fh_success" />

                    <TextView
                        style="@style/TextAppearance.FamilyHub.CardTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_12"
                        android:gravity="center"
                        android:text="@string/add_expense"
                        android:textColor="@color/fh_on_surface" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <View
                android:layout_width="@dimen/space_12"
                android:layout_height="0dp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/quick_family_live"
                style="@style/Widget.FamilyHub.Card.Flat"
                android:layout_width="0dp"
                android:layout_height="124dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="@color/fh_module_family_container"
                app:strokeColor="@color/fh_module_family">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:contentDescription="@string/family_live"
                        android:src="@drawable/ic_family"
                        app:tint="@color/fh_primary" />

                    <TextView
                        style="@style/TextAppearance.FamilyHub.CardTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_12"
                        android:gravity="center"
                        android:text="@string/family_live"
                        android:textColor="@color/fh_primary_dark" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- Overview heading -->
        <TextView
            style="@style/TextAppearance.FamilyHub.SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_20"
            android:text="@string/dashboard_overview"
            android:textColor="@color/fh_on_surface"
            android:textSize="16sp" />

        <!-- Reusable overview status cards -->
        <com.tridev.familyhub.core.ui.cards.StatusCardView
            android:id="@+id/card_finance_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8" />

        <com.tridev.familyhub.core.ui.cards.StatusCardView
            android:id="@+id/card_health_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_6" />

        <com.tridev.familyhub.core.ui.cards.StatusCardView
            android:id="@+id/card_family_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_6" />

        <com.tridev.familyhub.core.ui.cards.StatusCardView
            android:id="@+id/card_document_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_6" />

        <!-- Today overview heading -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/TextAppearance.FamilyHub.SectionTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/today_overview"
                android:textColor="@color/fh_on_surface"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/dashboard_view_all"
                style="@style/TextAppearance.FamilyHub.Overline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/view_all"
                android:textColor="@color/fh_primary"
                android:textSize="11sp" />

        </LinearLayout>

        <!-- Upcoming reminder card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.FamilyHub.Card.Flat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            app:cardBackgroundColor="@color/fh_module_reminders_container"
            app:strokeColor="@color/fh_module_reminders">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/space_12">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_placeholder_icon"
                    android:contentDescription="@string/upcoming_reminder"
                    android:padding="@dimen/space_6"
                    android:src="@drawable/ic_reminder"
                    app:tint="@color/fh_tertiary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_12"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                    android:id="@+id/dashboard_upcoming_reminder_title"
                    style="@style/TextAppearance.FamilyHub.CardTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/upcoming_reminder"
                    android:textColor="@color/fh_on_surface"
                    android:textSize="12sp" />

                    <TextView
                        android:id="@+id/dashboard_upcoming_reminder_detail"
                        style="@style/TextAppearance.FamilyHub.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:text="@string/upcoming_reminder_detail"
                    android:textColor="@color/fh_on_surface_variant"
                    android:textSize="11sp" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Finance summary card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.FamilyHub.Card.Flat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            app:cardBackgroundColor="@color/fh_module_finance_container"
            app:strokeColor="@color/fh_module_finance">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/space_12">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_placeholder_icon"
                    android:contentDescription="@string/monthly_spend"
                    android:padding="@dimen/space_6"
                    android:src="@drawable/ic_wallet"
                    app:tint="@color/fh_success" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_12"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextAppearance.FamilyHub.CardTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/monthly_spend"
                        android:textColor="@color/fh_on_surface"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/dashboard_monthly_expense_detail"
                        style="@style/TextAppearance.FamilyHub.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:text="@string/monthly_spend_detail"
                        android:textColor="@color/fh_on_surface_variant"
                        android:textSize="11sp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/dashboard_monthly_expense_value"
                    style="@style/TextAppearance.FamilyHub.CardTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/monthly_spend_value"
                    android:textColor="@color/fh_success"
                    android:textSize="14sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/TextAppearance.FamilyHub.SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:text="@string/dashboard_highlights"
            android:textColor="@color/fh_on_surface"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/dashboard_birthday_card"
                style="@style/Widget.FamilyHub.Card.Flat"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="@dimen/space_4"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="@color/fh_module_family_container"
                app:strokeColor="@color/fh_module_family">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch_target_min"
                    android:orientation="vertical"
                    android:padding="@dimen/space_8">

                    <TextView
                        android:id="@+id/dashboard_birthday_title"
                        style="@style/TextAppearance.FamilyHub.CardTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/dashboard_birthday_title"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/dashboard_birthday_detail"
                        style="@style/TextAppearance.FamilyHub.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:text="@string/dashboard_no_birthday_detail"
                        android:textSize="11sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/dashboard_bill_card"
                style="@style/Widget.FamilyHub.Card.Flat"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/space_4"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="@color/fh_module_reminders_container"
                app:strokeColor="@color/fh_module_reminders">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch_target_min"
                    android:orientation="vertical"
                    android:padding="@dimen/space_8">

                    <TextView
                        android:id="@+id/dashboard_bill_title"
                        style="@style/TextAppearance.FamilyHub.CardTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/dashboard_bills_title"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/dashboard_bill_detail"
                        style="@style/TextAppearance.FamilyHub.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:text="@string/dashboard_no_bill_detail"
                        android:textSize="11sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.FamilyHub.Card.Flat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/space_8">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_placeholder_icon"
                    android:contentDescription="@string/dashboard_recent_activity"
                    android:padding="@dimen/space_6"
                    android:src="@drawable/ic_note"
                    app:tint="@color/fh_primary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_8"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextAppearance.FamilyHub.CardTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dashboard_recent_activity"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/dashboard_recent_activity_detail"
                        style="@style/TextAppearance.FamilyHub.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:text="@string/dashboard_no_recent_activity"
                        android:textSize="11sp" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/dashboard_sos_button"
            style="@style/Widget.FamilyHub.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/space_8"
            android:contentDescription="@string/dashboard_sos_detail"
            android:text="@string/dashboard_sos_action"
            android:textColor="@color/fh_error"
            android:textSize="12sp"
            app:icon="@drawable/ic_health"
            app:iconTint="@color/fh_error"
            app:strokeColor="@color/fh_error" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
