<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@drawable/bg_page_three_tone"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding_horizontal"
        android:paddingTop="@dimen/compact_page_top_padding"
        android:paddingEnd="@dimen/screen_padding_horizontal"
        android:paddingBottom="@dimen/space_24">

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.FamilyHub.Card.Flat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/fh_surface"
            app:cardCornerRadius="@dimen/radius_20"
            app:strokeColor="@color/fh_outline_variant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/space_8">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonFamilySafetyBack"
                    style="@style/Widget.FamilyHub.Button.Tonal"
                    android:layout_width="@dimen/touch_target_min"
                    android:layout_height="@dimen/touch_target_min"
                    android:contentDescription="@string/action_back"
                    android:minWidth="0dp"
                    android:text=""
                    app:icon="@drawable/ic_arrow_back"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconTint="@color/fh_primary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_12"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextAppearance.FamilyHub.Heading"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/family_safety_center_title" />

                    <TextView
                        style="@style/TextAppearance.FamilyHub.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/family_safety_center_subtitle" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonFamilySafetyRefresh"
                    style="@style/Widget.FamilyHub.Button.Tonal"
                    android:layout_width="@dimen/touch_target_min"
                    android:layout_height="@dimen/touch_target_min"
                    android:contentDescription="@string/family_safety_center_refresh"
                    android:minWidth="0dp"
                    android:text=""
                    app:icon="@drawable/ic_refresh"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconTint="@color/fh_primary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardFamilySafetyOverview"
            style="@style/Widget.FamilyHub.Card.Flat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            app:cardBackgroundColor="@color/fh_success_container"
            app:cardCornerRadius="@dimen/radius_20"
            app:strokeColor="@color/fh_success"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/space_10">

                <ImageView
                    android:id="@+id/imageFamilySafetyOverview"
                    android:layout_width="48dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_placeholder_icon"
                    android:contentDescription="@null"
                    android:padding="8dp"
                    android:src="@drawable/ic_safe_place_shield"
                    app:tint="@color/fh_success" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_12"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/textFamilySafetyOverviewTitle"
                        style="@style/TextAppearance.FamilyHub.CardTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/family_safety_overview_loading" />

                    <TextView
                        android:id="@+id/textFamilySafetyOverviewDetail"
                        style="@style/TextAppearance.FamilyHub.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:text="@string/family_safety_center_subtitle" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/progressFamilySafetyOverview"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="@dimen/space_8" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_10"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.FamilyHub.Card.Flat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_4"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/fh_error_container"
                app:cardCornerRadius="@dimen/radius_16"
                app:strokeColor="@color/fh_error"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/space_8">

                    <TextView
                        android:id="@+id/textFamilySafetySosCount"
                        style="@style/TextAppearance.FamilyHub.Heading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/fh_error" />

                    <TextView
                        style="@style/TextAppearance.FamilyHub.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="center"
                        android:text="@string/family_safety_summary_sos" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.FamilyHub.Card.Flat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_4"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/fh_warning_container"
                app:cardCornerRadius="@dimen/radius_16"
                app:strokeColor="@color/fh_warning"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/space_8">

                    <TextView
                        android:id="@+id/textFamilySafetyAttentionCount"
                        style="@style/TextAppearance.FamilyHub.Heading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/fh_warning" />

                    <TextView
                        style="@style/TextAppearance.FamilyHub.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="center"
                        android:text="@string/family_safety_summary_attention" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.FamilyHub.Card.Flat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_4"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/fh_info_container"
                app:cardCornerRadius="@dimen/radius_16"
                app:strokeColor="@color/fh_info"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/space_8">

                    <TextView
                        android:id="@+id/textFamilySafetyUnreadCount"
                        style="@style/TextAppearance.FamilyHub.Heading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/fh_info" />

                    <TextView
                        style="@style/TextAppearance.FamilyHub.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="center"
                        android:text="@string/family_safety_summary_unread" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.FamilyHub.Card.Flat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_4"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/fh_primary_container"
                app:cardCornerRadius="@dimen/radius_16"
                app:strokeColor="@color/fh_primary"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/space_8">

                    <TextView
                        android:id="@+id/textFamilySafetyMemberCount"
                        style="@style/TextAppearance.FamilyHub.Heading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/fh_primary" />

                    <TextView
                        style="@style/TextAppearance.FamilyHub.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="center"
                        android:text="@string/family_safety_summary_members" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <TextView
            style="@style/TextAppearance.FamilyHub.Overline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/compact_section_spacing"
            android:text="@string/family_safety_actions_title"
            android:textColor="@color/fh_primary" />

        <TextView
            style="@style/TextAppearance.FamilyHub.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/family_safety_actions_helper" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardFamilySafetySos"
            style="@style/Widget.FamilyHub.Card.Flat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_10"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="@color/fh_error_container"
            app:cardCornerRadius="@dimen/radius_18"
            app:strokeColor="@color/fh_error"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/space_10">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_placeholder_icon"
                    android:contentDescription="@null"
                    android:padding="10dp"
                    android:src="@drawable/ic_family_sos"
                    app:tint="@color/fh_error" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_12"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextAppearance.FamilyHub.CardTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/family_safety_action_sos_title"
                        android:textColor="@color/fh_error" />

                    <TextView
                        style="@style/TextAppearance.FamilyHub.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/family_safety_action_sos_detail" />
                </LinearLayout>

                <ImageView
                    android:layout_width="@dimen/icon_size_small"
                    android:layout_height="@dimen/icon_size_small"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_arrow_right"
                    app:tint="@color/fh_error" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardFamilySafetyMap"
            style="@style/Widget.FamilyHub.Card.Flat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="@color/fh_primary_container"
            app:cardCornerRadius="@dimen/radius_18"
            app:strokeColor="@color/fh_primary"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/space_10">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_placeholder_icon"
                    android:contentDescription="@null"
                    android:padding="10dp"
                    android:src="@drawable/ic_family_map_recenter"
                    app:tint="@color/fh_primary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_12"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextAppearance.FamilyHub.CardTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/family_safety_action_map_title"
                        android:textColor="@color/fh_primary" />

                    <TextView
                        style="@style/TextAppearance.FamilyHub.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/family_safety_action_map_detail" />
                </LinearLayout>

                <ImageView
                    android:layout_width="@dimen/icon_size_small"
                    android:layout_height="@dimen/icon_size_small"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_arrow_right"
                    app:tint="@color/fh_primary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardFamilySafetyPlaces"
            style="@style/Widget.FamilyHub.Card.Flat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="@color/fh_success_container"
            app:cardCornerRadius="@dimen/radius_18"
            app:strokeColor="@color/fh_success"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/space_10">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_placeholder_icon"
                    android:contentDescription="@null"
                    android:padding="10dp"
                    android:src="@drawable/ic_safe_place_pin"
                    app:tint="@color/fh_success" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_12"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextAppearance.FamilyHub.CardTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/family_safety_action_places_title"
                        android:textColor="@color/fh_success" />

                    <TextView
                        style="@style/TextAppearance.FamilyHub.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/family_safety_action_places_detail" />
                </LinearLayout>

                <ImageView
                    android:layout_width="@dimen/icon_size_small"
                    android:layout_height="@dimen/icon_size_small"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_arrow_right"
                    app:tint="@color/fh_success" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardFamilySafetyAlerts"
            style="@style/Widget.FamilyHub.Card.Flat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="@color/fh_info_container"
            app:cardCornerRadius="@dimen/radius_18"
            app:strokeColor="@color/fh_info"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/space_10">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_placeholder_icon"
                    android:contentDescription="@null"
                    android:padding="10dp"
                    android:src="@drawable/ic_safe_place_alert_history"
                    app:tint="@color/fh_info" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_12"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextAppearance.FamilyHub.CardTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/family_safety_action_alerts_title"
                        android:textColor="@color/fh_info" />

                    <TextView
                        style="@style/TextAppearance.FamilyHub.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/family_safety_action_alerts_detail" />
                </LinearLayout>

                <ImageView
                    android:layout_width="@dimen/icon_size_small"
                    android:layout_height="@dimen/icon_size_small"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_arrow_right"
                    app:tint="@color/fh_info" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.FamilyHub.Card.Flat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            app:cardBackgroundColor="@color/fh_surface"
            app:cardCornerRadius="@dimen/radius_16"
            app:strokeColor="@color/fh_outline_variant"
            app:strokeWidth="1dp">

            <TextView
                style="@style/TextAppearance.FamilyHub.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/space_12"
                android:text="@string/family_safety_privacy_note" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
