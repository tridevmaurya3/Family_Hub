<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_form_floating_shell"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingTop="6dp"
        android:paddingEnd="8dp"
        android:paddingBottom="10dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="36dp"
            android:layout_height="3dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="6dp"
            app:cardBackgroundColor="@color/fh_outline_variant"
            app:cardCornerRadius="2dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.FamilyHub.Form.Header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/fh_success_container"
            app:cardCornerRadius="12dp"
            app:strokeColor="@color/fh_success">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="8dp">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_placeholder_icon"
                    android:contentDescription="@null"
                    android:padding="7dp"
                    android:src="@drawable/ic_note"
                    app:tint="@color/fh_success" />

                <TextView
                    android:id="@+id/note_dialog_title"
                    style="@style/TextAppearance.FamilyHub.SectionTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/notes_add"
                    android:textColor="@color/fh_success"
                    android:textSize="15sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.FamilyHub.Form.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:cardBackgroundColor="@color/fh_surface_container"
            app:cardCornerRadius="12dp"
            app:strokeColor="@color/fh_outline_variant">
            <LinearLayout android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:padding="7dp">
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/note_title_layout"
            style="@style/Widget.FamilyHub.FloatingCompact.Field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/notes_title_label">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/note_title_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences"
                android:maxLines="2"
                android:minHeight="44dp"
                android:textSize="12sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.FamilyHub.FloatingCompact.Field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:hint="@string/notes_content_label">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/note_content_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="10"
                android:minLines="3"
                android:textSize="12sp" />
        </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.FamilyHub.Form.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:cardBackgroundColor="@color/fh_primary_container"
            app:cardCornerRadius="12dp"
            app:strokeColor="@color/fh_primary">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="7dp">
                <TextView style="@style/TextAppearance.FamilyHub.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="@string/notes_options_heading"
                    android:textColor="@color/fh_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <LinearLayout android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="horizontal">
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.FamilyHub.FloatingCompact.Dropdown"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="3dp"
                        android:layout_weight="1"
                        android:hint="@string/notes_category_label">
                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/note_category_input"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:ellipsize="end"
                            android:gravity="center_vertical"
                            android:inputType="none"
                            android:maxLines="1"
                            android:paddingStart="8dp"
                            android:paddingEnd="4dp"
                            android:textSize="11.5sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.FamilyHub.FloatingCompact.Dropdown"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3dp"
                        android:layout_weight="1"
                        android:hint="@string/notes_type_label">
                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/note_type_input"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:ellipsize="end"
                            android:gravity="center_vertical"
                            android:inputType="none"
                            android:maxLines="1"
                            android:paddingStart="8dp"
                            android:paddingEnd="4dp"
                            android:textSize="11.5sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="5dp">
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.FamilyHub.FloatingCompact.Dropdown"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="3dp"
                        android:layout_weight="1"
                        android:hint="@string/notes_color_label">
                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/note_color_input"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:ellipsize="end"
                            android:gravity="center_vertical"
                            android:inputType="none"
                            android:maxLines="1"
                            android:paddingStart="8dp"
                            android:paddingEnd="4dp"
                            android:textSize="11.5sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.FamilyHub.FloatingCompact.Dropdown"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3dp"
                        android:layout_weight="1"
                        android:hint="@string/collaboration_status">
                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/note_collaboration_status_input"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:ellipsize="end"
                            android:gravity="center_vertical"
                            android:inputType="none"
                            android:maxLines="1"
                            android:paddingStart="8dp"
                            android:paddingEnd="4dp"
                            android:textSize="11.5sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            style="@style/Widget.FamilyHub.FloatingCompact.Switch"
            android:id="@+id/note_shared_switch"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="@string/share_with_family" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.FamilyHub.FloatingCompact.Field"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:hint="@string/notes_reminder_label"
            app:endIconMode="custom"
            app:endIconDrawable="@drawable/ic_reminder">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/note_reminder_input"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:clickable="true" android:cursorVisible="false"
                android:focusable="false" android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cancel_note_button"
                style="@style/Widget.FamilyHub.Form.CompactCancel"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="@dimen/space_4"
                android:layout_weight="1"
                android:text="@string/cancel" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/save_note_button"
                style="@style/Widget.FamilyHub.FloatingCompact.PrimaryAction"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="@dimen/space_4"
                android:layout_weight="1.25"
                android:text="@string/notes_save"
                app:icon="@drawable/ic_note" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
