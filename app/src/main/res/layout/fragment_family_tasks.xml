<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/bg_page_three_tone"
    android:paddingStart="@dimen/screen_padding_horizontal"
    android:paddingTop="@dimen/compact_page_top_padding"
    android:paddingEnd="@dimen/screen_padding_horizontal">

    <com.tridev.familyhub.core.ui.cards.ModuleOverviewView
        android:id="@+id/task_overview" android:layout_width="0dp" android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" app:overviewAccentColor="@color/fh_module_grocery"
        app:overviewContainerColor="@color/fh_module_grocery_container"
        app:overviewDetail="@string/family_tasks_subtitle" app:overviewIcon="@drawable/ic_family_task"
        app:overviewTitle="@string/family_tasks_title" />

    <LinearLayout android:id="@+id/task_quick_add_panel"
        android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_12" android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/task_overview">
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.FamilyHub.TextInputLayout" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:hint="@string/family_tasks_quick_add_hint" app:startIconDrawable="@drawable/ic_family_task">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/task_quick_add_input" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:imeOptions="actionDone"
                android:inputType="textCapSentences" android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/task_quick_add_button" style="@style/Widget.FamilyHub.Button.Primary"
            android:layout_width="wrap_content" android:layout_height="@dimen/button_height"
            android:layout_marginStart="@dimen/space_8" android:text="@string/family_tasks_add"
            app:icon="@drawable/ic_add" />
    </LinearLayout>

    <HorizontalScrollView android:id="@+id/task_filter_scroll"
        android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8" android:fillViewport="false"
        android:scrollbars="none" app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/task_quick_add_panel">
        <com.google.android.material.chip.ChipGroup android:id="@+id/task_filter_group"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            app:chipSpacingHorizontal="@dimen/space_6" app:selectionRequired="true"
            app:singleSelection="true">
            <com.google.android.material.chip.Chip android:id="@+id/task_filter_today"
                style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:checked="true" android:text="@string/task_filter_today" />
            <com.google.android.material.chip.Chip android:id="@+id/task_filter_tomorrow"
                style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="@string/task_filter_tomorrow" />
            <com.google.android.material.chip.Chip android:id="@+id/task_filter_week"
                style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="@string/task_filter_week" />
            <com.google.android.material.chip.Chip android:id="@+id/task_filter_15_days"
                style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="@string/task_filter_15_days" />
            <com.google.android.material.chip.Chip android:id="@+id/task_filter_month"
                style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="@string/task_filter_month" />
            <com.google.android.material.chip.Chip android:id="@+id/task_filter_all"
                style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="@string/task_filter_all" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/task_search_layout" style="@style/Widget.FamilyHub.TextInputLayout"
        android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8" android:hint="@string/family_tasks_search_hint"
        app:endIconMode="clear_text" app:startIconDrawable="@drawable/ic_search"
        app:startIconTint="@color/fh_module_grocery"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/task_filter_scroll">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/task_search_input" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView android:id="@+id/task_result_summary"
        style="@style/TextAppearance.FamilyHub.Caption" android:layout_width="0dp"
        android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_6"
        android:textColor="@color/fh_module_grocery" android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/task_search_layout" />

    <androidx.recyclerview.widget.RecyclerView android:id="@+id/task_recycler_view"
        android:layout_width="0dp" android:layout_height="0dp" android:clipToPadding="false"
        android:paddingTop="@dimen/space_8" android:paddingBottom="88dp"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/task_result_summary"
        app:layout_constraintBottom_toBottomOf="parent" />

    <com.google.android.material.card.MaterialCardView android:id="@+id/task_empty_state"
        style="@style/Widget.FamilyHub.Card.Flat" android:layout_width="0dp"
        android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_16"
        android:visibility="gone" app:cardBackgroundColor="@color/fh_module_grocery_container"
        app:strokeColor="@color/fh_module_grocery" app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/task_result_summary">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center" android:orientation="vertical" android:padding="@dimen/compact_empty_state_padding">
            <ImageView android:layout_width="@dimen/compact_empty_state_icon_size"
                android:layout_height="@dimen/compact_empty_state_icon_size" android:background="@drawable/bg_placeholder_icon"
                android:contentDescription="@null" android:padding="@dimen/compact_empty_state_icon_padding"
                android:src="@drawable/ic_family_task" />
            <TextView style="@style/TextAppearance.FamilyHub.SectionTitle" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_8"
                android:text="@string/family_tasks_empty_title" />
            <TextView style="@style/TextAppearance.FamilyHub.Body" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_6"
                android:gravity="center" android:text="@string/family_tasks_empty_detail" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</androidx.constraintlayout.widget.ConstraintLayout>
