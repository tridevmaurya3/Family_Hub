<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/memberDetailRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@drawable/bg_page_three_tone"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding_horizontal"
        android:paddingTop="@dimen/space_12"
        android:paddingEnd="@dimen/screen_padding_horizontal">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonMemberDetailBack"
                style="@style/Widget.FamilyHub.Button.Tonal"
                android:layout_width="@dimen/touch_target_min"
                android:layout_height="@dimen/touch_target_min"
                android:contentDescription="@string/family_map_back_description"
                android:minWidth="0dp"
                android:text=""
                app:icon="@drawable/ic_arrow_back"
                app:iconPadding="0dp" />

            <TextView
                style="@style/TextAppearance.FamilyHub.SectionTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_12"
                android:layout_weight="1"
                android:text="@string/family_member_detail_title" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonMemberDetailRetry"
                style="@style/Widget.FamilyHub.Button.Tonal"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_target_min"
                android:minWidth="0dp"
                android:text="@string/family_map_retry" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/memberDetailLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_32" />

        <TextView
            android:id="@+id/memberDetailUnavailable"
            style="@style/TextAppearance.FamilyHub.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_32"
            android:gravity="center"
            android:text="@string/family_member_detail_unavailable"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/memberDetailContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.FamilyHub.Card.Data"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/fh_module_family_container">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/card_padding">

                    <TextView
                        android:id="@+id/tvMemberDetailAvatar"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/bg_member_avatar"
                        android:gravity="center"
                        android:textColor="@color/fh_on_primary"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_16"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView android:id="@+id/tvMemberDetailName" style="@style/TextAppearance.FamilyHub.SectionTitle" android:layout_width="match_parent" android:layout_height="wrap_content" />
                        <TextView android:id="@+id/tvMemberDetailRole" style="@style/TextAppearance.FamilyHub.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_4" />
                        <TextView android:id="@+id/tvMemberDetailAvailability" style="@style/TextAppearance.FamilyHub.BodyStrong" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_8" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <include layout="@layout/view_family_member_location_card" />
            <include layout="@layout/view_family_member_device_card" />
            <include layout="@layout/view_family_member_movement_card" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonMemberDetailMap"
                style="@style/Widget.FamilyHub.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_24"
                android:minHeight="@dimen/touch_target_min"
                android:text="@string/family_member_detail_view_map" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
