<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_page_three_tone"
    android:paddingStart="@dimen/screen_padding_horizontal"
    android:paddingTop="@dimen/space_6"
    android:paddingEnd="@dimen/screen_padding_horizontal">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/documents_header_card"
        style="@style/Widget.FamilyHub.Card.Flat"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/fh_surface"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:strokeColor="@color/fh_outline">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="7dp">

            <ImageButton
                android:id="@+id/documents_back_button"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="@dimen/space_6"
                android:background="@drawable/bg_icon_button"
                android:contentDescription="@string/feature_menu_title"
                android:padding="9dp"
                android:src="@drawable/ic_menu_hamburger"
                app:tint="@color/fh_module_documents" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="@dimen/space_8"
                app:cardBackgroundColor="@color/fh_module_documents_container"
                app:cardCornerRadius="@dimen/radius_12"
                app:cardElevation="0dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_document"
                    app:tint="@color/fh_module_documents" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/documents_title"
                    style="@style/TextAppearance.FamilyHub.Heading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/documents_vault_title"
                    android:textColor="@color/fh_on_surface"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/documents_subtitle"
                    style="@style/TextAppearance.FamilyHub.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/documents_vault_subtitle"
                    android:textSize="9sp" />
            </LinearLayout>

            <ImageButton android:id="@+id/documents_notification_button"
                android:layout_width="36dp" android:layout_height="36dp"
                android:background="@drawable/bg_icon_button" android:contentDescription="@string/reminders_title"
                android:padding="9dp" android:src="@drawable/ic_bell" app:tint="@color/fh_module_documents" />
            <ImageButton android:id="@+id/documents_profile_button"
                android:layout_width="36dp" android:layout_height="36dp" android:layout_marginStart="@dimen/space_4"
                android:background="@drawable/bg_icon_button" android:contentDescription="@string/more_profile_title"
                android:padding="9dp" android:src="@drawable/ic_profile_person" app:tint="@color/fh_module_documents" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/documents_lock_card"
        style="@style/Widget.FamilyHub.Card.Subtle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_6"
        app:cardBackgroundColor="@color/fh_module_documents_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/documents_header_card"
        app:strokeColor="@color/fh_module_documents">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_8"
            android:paddingTop="5dp"
            android:paddingEnd="@dimen/space_6"
            android:paddingBottom="5dp">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_placeholder_icon"
                android:contentDescription="@null"
                android:padding="7dp"
                android:src="@drawable/ic_safe_place_shield"
                app:tint="@color/fh_module_documents" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_6"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.FamilyHub.CardTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/documents_vault_lock"
                    android:textSize="12sp" />

                <TextView
                    style="@style/TextAppearance.FamilyHub.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/documents_vault_lock_detail"
                    android:textSize="9sp" />
            </LinearLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switch_document_vault_lock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_4"
                android:contentDescription="@string/documents_vault_lock" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/documents_locked_state"
        style="@style/Widget.FamilyHub.Card.Flat"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_6"
        android:visibility="gone"
        app:cardBackgroundColor="@color/fh_module_documents_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/documents_lock_card"
        app:strokeColor="@color/fh_module_documents">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="18dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_placeholder_icon"
                android:contentDescription="@null"
                android:padding="10dp"
                android:src="@drawable/ic_safe_place_shield"
                app:tint="@color/fh_module_documents" />

            <TextView
                style="@style/TextAppearance.FamilyHub.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:text="@string/documents_vault_locked_title" />

            <TextView
                style="@style/TextAppearance.FamilyHub.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:gravity="center"
                android:text="@string/documents_vault_locked_detail"
                android:textAlignment="center" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/unlock_documents_button"
                style="@style/Widget.FamilyHub.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginTop="@dimen/space_10"
                android:textSize="11sp"
                android:text="@string/documents_vault_unlock"
                app:icon="@drawable/ic_safe_place_shield"
                app:iconGravity="textStart" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:id="@+id/documents_vault_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_6"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/documents_lock_card">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:weightSum="4">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.FamilyHub.Card.Subtle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="4dp"
                android:layout_weight="1">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/text_documents_total"
                        style="@style/TextAppearance.FamilyHub.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/fh_module_documents"
                        android:textSize="15sp" />
                    <TextView
                        style="@style/TextAppearance.FamilyHub.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/documents_vault_total"
                        android:textSize="9sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.FamilyHub.Card.Subtle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/text_documents_expiring"
                        style="@style/TextAppearance.FamilyHub.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/fh_warning"
                        android:textSize="15sp" />
                    <TextView
                        style="@style/TextAppearance.FamilyHub.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/documents_vault_expiring"
                        android:textSize="9sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.FamilyHub.Card.Subtle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_weight="1">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/text_documents_expired"
                        style="@style/TextAppearance.FamilyHub.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/fh_error"
                        android:textSize="15sp" />
                    <TextView
                        style="@style/TextAppearance.FamilyHub.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/documents_vault_expired"
                        android:textSize="9sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.FamilyHub.Card.Subtle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_weight="1">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/text_documents_trash"
                        style="@style/TextAppearance.FamilyHub.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/fh_info"
                        android:textSize="15sp" />
                    <TextView
                        style="@style/TextAppearance.FamilyHub.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/documents_vault_filter_trash"
                        android:textSize="9sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.FamilyHub.Card.Subtle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_6">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/space_10"
                android:paddingTop="2dp"
                android:paddingEnd="@dimen/space_6"
                android:paddingBottom="2dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextAppearance.FamilyHub.CardTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/documents_vault_expiry_alerts"
                        android:textSize="11sp" />

                    <TextView
                        style="@style/TextAppearance.FamilyHub.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/documents_vault_remind_before"
                        android:textSize="9sp" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_document_expiry_alerts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/space_4"
                    android:contentDescription="@string/documents_vault_expiry_alerts" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.FamilyHub.Form.Dropdown"
                    android:layout_width="88dp"
                    android:layout_height="wrap_content"
                    android:hint="@null">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/document_reminder_days_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:maxLines="1"
                        android:textSize="11sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_documents_lock_now"
                    style="@style/Widget.FamilyHub.Button.Action"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/touch_target_min"
                    android:minWidth="0dp"
                    android:text="@string/documents_vault_lock_now"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.FamilyHub.Card.Flat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_6"
            app:cardBackgroundColor="@color/fh_surface"
            app:strokeColor="@color/fh_outline">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_6">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.FamilyHub.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="@string/documents_search_hint"
                    app:endIconMode="clear_text"
                    app:startIconDrawable="@drawable/ic_search"
                    app:startIconTint="@color/fh_module_documents">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/document_search_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.FamilyHub.Form.Dropdown"
                        android:layout_width="104dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_4"
                        android:hint="@string/documents_vault_category_filter">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/document_category_filter_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            android:maxLines="1"
                            android:textSize="11sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <HorizontalScrollView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fillViewport="false"
                        android:scrollbars="none">

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/document_filter_group"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:selectionRequired="true"
                            app:singleLine="true"
                            app:singleSelection="true">

                            <com.google.android.material.chip.Chip
                                android:id="@+id/filter_all_chip"
                                style="@style/Widget.FamilyHub.StatusChip"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minHeight="32dp"
                                android:textSize="10sp"
                                android:checkable="true"
                                android:checked="true"
                                android:text="@string/documents_vault_filter_all" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/filter_expiring_chip"
                                style="@style/Widget.FamilyHub.StatusChip"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minHeight="32dp"
                                android:textSize="10sp"
                                android:checkable="true"
                                android:text="@string/documents_vault_filter_expiring" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/filter_expired_chip"
                                style="@style/Widget.FamilyHub.StatusChip"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minHeight="32dp"
                                android:textSize="10sp"
                                android:checkable="true"
                                android:text="@string/documents_vault_filter_expired" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/filter_favorites_chip"
                                style="@style/Widget.FamilyHub.StatusChip"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minHeight="32dp"
                                android:textSize="10sp"
                                android:checkable="true"
                                android:text="@string/documents_vault_filter_favorites" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/filter_emergency_chip"
                                style="@style/Widget.FamilyHub.StatusChip"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minHeight="32dp"
                                android:textSize="10sp"
                                android:checkable="true"
                                android:text="@string/documents_vault_filter_emergency" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/filter_trash_chip"
                                style="@style/Widget.FamilyHub.StatusChip"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minHeight="32dp"
                                android:textSize="10sp"
                                android:checkable="true"
                                android:text="@string/documents_vault_filter_trash" />
                        </com.google.android.material.chip.ChipGroup>
                    </HorizontalScrollView>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_missing_documents_checklist"
            style="@style/Widget.FamilyHub.Button.Action"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="end"
            android:layout_marginTop="@dimen/space_4"
            android:minWidth="0dp"
            android:textSize="10sp"
            android:text="@string/documents_vault_missing_checklist"
            app:icon="@drawable/ic_document"
            app:iconGravity="textStart" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="end"
            android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_documents_pdf"
                style="@style/Widget.FamilyHub.Button.Action"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:minWidth="0dp"
                android:text="@string/documents_vault_pdf_report"
                android:textSize="10sp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_documents_excel"
                style="@style/Widget.FamilyHub.Button.Action"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:minWidth="0dp"
                android:text="@string/documents_vault_excel_report"
                android:textSize="10sp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_documents_report_share"
                style="@style/Widget.FamilyHub.Button.Action"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:minWidth="0dp"
                android:text="@string/documents_vault_share_report"
                android:textSize="10sp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_documents_integrity"
                style="@style/Widget.FamilyHub.Button.Action"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:minWidth="0dp"
                android:text="@string/documents_vault_integrity"
                android:textSize="10sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/space_4"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/document_recycler_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="@dimen/space_6"
                android:paddingBottom="88dp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/documents_empty_state"
                style="@style/Widget.FamilyHub.Card.Flat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:visibility="gone"
                app:cardBackgroundColor="@color/fh_module_documents_container"
                app:strokeColor="@color/fh_module_documents">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/space_14">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_placeholder_icon"
                        android:contentDescription="@null"
                        android:padding="9dp"
                        android:src="@drawable/ic_document"
                        app:tint="@color/fh_module_documents" />

                    <TextView
                        android:id="@+id/documents_empty_title"
                        style="@style/TextAppearance.FamilyHub.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:gravity="center"
                        android:text="@string/documents_empty_title" />

                    <TextView
                        android:id="@+id/documents_empty_detail"
                        style="@style/TextAppearance.FamilyHub.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:gravity="center"
                        android:maxLines="2"
                        android:text="@string/documents_empty_detail"
                        android:textAlignment="center"
                        android:textSize="11sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/empty_add_document_button"
                        style="@style/Widget.FamilyHub.Button.Primary"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginTop="@dimen/space_8"
