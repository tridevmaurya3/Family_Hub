<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/familyLiveSummarySurface"
    style="@style/Widget.FamilyHub.Card.Flat"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/fh_surface"
    app:strokeColor="@color/fh_outline">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/family_live_summary_padding">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/familyLiveSummaryIconContainer"
                android:layout_width="@dimen/family_live_summary_icon_container"
                android:layout_height="@dimen/family_live_summary_icon_container"
                app:cardBackgroundColor="@color/fh_error_container"
                app:cardCornerRadius="@dimen/radius_12"
                app:cardElevation="0dp"
                app:strokeColor="@color/fh_outline_variant"
                app:strokeWidth="@dimen/border_width">

                <ImageView
                    android:id="@+id/familyLiveSummaryIcon"
                    android:layout_width="@dimen/family_live_summary_icon_size"
                    android:layout_height="@dimen/family_live_summary_icon_size"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_fh_shield_check"
                    app:tint="@color/fh_error" />

            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_10"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvFamilySafetyState"
                    style="@style/TextAppearance.FamilyHub.SectionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="@string/family_live_summary_waiting"
                    android:textColor="@color/fh_module_family"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvFamilySafetyDetail"
                    style="@style/TextAppearance.FamilyHub.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/family_live_summary_waiting_detail"
                    android:textColor="@color/fh_text_secondary"
                    android:textSize="11sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_8"
                android:gravity="end"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/familyLiveSyncIcon"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="end"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_fh_sync"
                    app:tint="@color/fh_text_secondary" />

                <TextView
                    android:id="@+id/tvFamilyLastSync"
                    style="@style/TextAppearance.FamilyHub.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:maxLines="1"
                    android:text="@string/family_live_summary_sync_none"
                    android:textColor="@color/fh_text_secondary"
                    android:textSize="9sp" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.FamilyHub.Card.Subtle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/family_live_summary_metric_gap"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/fh_module_family_container"
                app:strokeColor="@color/fh_outline_variant">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/family_live_summary_metric_height"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/space_4">

                    <TextView
                        android:id="@+id/tvSummaryTotal"
                        style="@style/TextAppearance.FamilyHub.CardTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/family_live_summary_zero"
                        android:textColor="@color/fh_module_family" />

                    <TextView
                        style="@style/TextAppearance.FamilyHub.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:maxLines="1"
                        android:text="@string/family_live_summary_total"
                        android:textColor="@color/fh_module_family"
                        android:textSize="10sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.FamilyHub.Card.Subtle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/family_live_summary_metric_gap"
                android:layout_marginEnd="@dimen/family_live_summary_metric_gap"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/fh_success_container"
                app:strokeColor="@color/fh_outline_variant">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/family_live_summary_metric_height"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/space_4">

                    <TextView
                        android:id="@+id/tvSummaryLive"
                        style="@style/TextAppearance.FamilyHub.CardTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/family_live_summary_zero"
                        android:textColor="@color/fh_success" />

                    <TextView
                        style="@style/TextAppearance.FamilyHub.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:maxLines="1"
                        android:text="@string/family_live_summary_live"
                        android:textColor="@color/fh_success"
                        android:textSize="10sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.FamilyHub.Card.Subtle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/family_live_summary_metric_gap"
                android:layout_marginEnd="@dimen/family_live_summary_metric_gap"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/fh_module_planner_container"
                app:strokeColor="@color/fh_outline_variant">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/family_live_summary_metric_height"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/space_4">

                    <TextView
                        android:id="@+id/tvSummaryTravelling"
                        style="@style/TextAppearance.FamilyHub.CardTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/family_live_summary_zero"
                        android:textColor="@color/fh_module_planner" />

                    <TextView
                        style="@style/TextAppearance.FamilyHub.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:maxLines="1"
                        android:text="@string/family_live_summary_travelling"
                        android:textColor="@color/fh_module_planner"
                        android:textSize="9sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/familyLiveAttentionMetric"
                style="@style/Widget.FamilyHub.Card.Subtle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/family_live_summary_metric_gap"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/fh_error_container"
                app:strokeColor="@color/fh_outline_variant">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/family_live_summary_metric_height"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/space_4">

                    <TextView
                        android:id="@+id/tvSummaryAttention"
                        style="@style/TextAppearance.FamilyHub.CardTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/family_live_summary_zero"
                        android:textColor="@color/fh_error" />

                    <TextView
                        android:id="@+id/tvSummaryAttentionLabel"
                        style="@style/TextAppearance.FamilyHub.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:maxLines="1"
                        android:text="@string/family_live_summary_attention"
                        android:textColor="@color/fh_error"
                        android:textSize="9sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
