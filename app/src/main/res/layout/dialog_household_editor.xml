<?xml version='1.0' encoding='UTF-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_form_floating_shell"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingTop="6dp"
    android:paddingEnd="8dp"
    android:paddingBottom="10dp">
    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.FamilyHub.Form.Header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardBackgroundColor="@color/fh_success_container"
        app:strokeColor="@color/fh_success">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:orientation="vertical">
            <TextView
                style="@style/TextAppearance.FamilyHub.SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/household_create_title"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.FamilyHub.Form.Section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        app:cardCornerRadius="12dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="7dp">
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/household_name_layout"
                style="@style/Widget.FamilyHub.FloatingCompact.Field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:hint="@string/household_name_hint">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/household_name_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapWords"
                    android:maxLength="60"/>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/household_guardian_layout"
                style="@style/Widget.FamilyHub.FloatingCompact.Dropdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:hint="@string/household_guardian_hint">
                <AutoCompleteTextView
                    android:id="@+id/household_guardian_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"/>
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:gravity="end"
        android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_cancel_household"
            style="@style/Widget.FamilyHub.Form.CompactCancel"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="@string/action_cancel"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_save_household"
            style="@style/Widget.FamilyHub.FloatingCompact.PrimaryAction"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="@dimen/space_8"
            android:text="@string/household_create"/>
    </LinearLayout>
</LinearLayout>