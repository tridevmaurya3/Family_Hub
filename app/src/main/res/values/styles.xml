<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Product-style Fluent cards -->
    <style name="Widget.FamilyHub.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/fh_surface</item>
        <item name="cardCornerRadius">@dimen/radius_18</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="strokeColor">@color/fh_outline</item>
        <item name="strokeWidth">@dimen/border_width</item>
    </style>

    <style name="Widget.FamilyHub.Card.Flat" parent="Widget.FamilyHub.Card">
        <item name="cardElevation">0dp</item>
    </style>

    <style name="Widget.FamilyHub.Card.Subtle" parent="Widget.FamilyHub.Card.Flat">
        <item name="cardBackgroundColor">@color/fh_surface_container</item>
        <item name="cardCornerRadius">@dimen/radius_14</item>
        <item name="strokeColor">@color/fh_outline_variant</item>
    </style>

    <style name="Widget.FamilyHub.Card.FormSection" parent="Widget.FamilyHub.Card.Flat">
        <item name="cardBackgroundColor">@color/fh_form_surface</item>
        <item name="cardCornerRadius">@dimen/radius_20</item>
        <item name="strokeColor">@color/fh_form_outline</item>
    </style>

    <!-- Standard for every present and future Family Hub form section. -->
    <style name="Widget.FamilyHub.Form.Section" parent="Widget.FamilyHub.Card.FormSection">
        <item name="cardCornerRadius">@dimen/radius_16</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">@dimen/border_width</item>
    </style>

    <style name="Widget.FamilyHub.Form.Header" parent="Widget.FamilyHub.Card.Flat">
        <item name="cardBackgroundColor">@color/fh_form_surface_tint</item>
        <item name="cardCornerRadius">@dimen/radius_16</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/fh_form_outline</item>
    </style>

    <style name="Widget.FamilyHub.Button.FormPrimary" parent="Widget.FamilyHub.Button.Primary">
        <item name="backgroundTint">@color/fh_form_accent</item>
        <item name="cornerRadius">@dimen/radius_24</item>
    </style>

    <style name="Widget.FamilyHub.Button.FormSecondary" parent="Widget.FamilyHub.Button.Tonal">
        <item name="android:textColor">@color/fh_form_accent</item>
        <item name="backgroundTint">@color/fh_form_accent_container</item>
        <item name="cornerRadius">@dimen/radius_24</item>
        <item name="iconTint">@color/fh_form_accent</item>
    </style>

    <style name="Widget.FamilyHub.Card.Data" parent="Widget.FamilyHub.Card">
        <item name="cardBackgroundColor">@color/fh_surface</item>
        <item name="cardCornerRadius">@dimen/radius_18</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/fh_outline</item>
    </style>

    <!-- Office-blue primary and supporting actions -->
    <style name="Widget.FamilyHub.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textAppearance">@style/TextAppearance.FamilyHub.Label</item>
        <item name="backgroundTint">@color/fh_primary</item>
        <item name="cornerRadius">@dimen/radius_24</item>
        <item name="iconTint">@color/fh_on_primary</item>
    </style>

    <style name="Widget.FamilyHub.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textAppearance">@style/TextAppearance.FamilyHub.Label</item>
        <item name="backgroundTint">@color/fh_primary_container</item>
        <item name="cornerRadius">@dimen/radius_24</item>
        <item name="iconTint">@color/fh_primary</item>
    </style>

    <style name="Widget.FamilyHub.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textAppearance">@style/TextAppearance.FamilyHub.Label</item>
        <item name="cornerRadius">@dimen/radius_24</item>
        <item name="iconTint">@color/fh_primary</item>
        <item name="strokeColor">@color/fh_outline</item>
        <item name="strokeWidth">@dimen/border_width</item>
    </style>

    <style name="Widget.FamilyHub.Button.Action" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textAppearance">@style/TextAppearance.FamilyHub.Label</item>
        <item name="android:textColor">@color/fh_primary</item>
        <item name="iconTint">@color/fh_primary</item>
    </style>

    <style name="Widget.FamilyHub.Button.Text" parent="Widget.FamilyHub.Button.Action" />

    <style name="Widget.FamilyHub.Button.Danger" parent="Widget.FamilyHub.Button.Action">
        <item name="android:textColor">@color/fh_error</item>
        <item name="iconTint">@color/fh_error</item>
    </style>

    <style name="Widget.FamilyHub.Form.Dropdown" parent="Widget.FamilyHub.TextInputLayout">
        <item name="android:elevation">2dp</item>
        <item name="boxBackgroundColor">@color/fh_surface</item>
        <item name="boxCornerRadiusTopStart">@dimen/radius_18</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_18</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_18</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_18</item>
        <item name="boxStrokeColor">@color/fh_form_outline</item>
        <item name="boxStrokeWidth">@dimen/border_width</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="endIconMode">dropdown_menu</item>
        <item name="endIconTint">@color/fh_form_accent</item>
    </style>

    <style name="Widget.FamilyHub.Form.Date" parent="Widget.FamilyHub.TextInputLayout">
        <item name="endIconMode">custom</item>
        <item name="endIconDrawable">@drawable/ic_reminder</item>
        <item name="endIconTint">@color/fh_primary</item>
    </style>

    <style name="Widget.FamilyHub.StatusChip" parent="Widget.Material3.Chip.Assist">
        <item name="android:textAppearance">@style/TextAppearance.FamilyHub.Label</item>
        <item name="chipBackgroundColor">@color/fh_primary_container</item>
        <item name="chipCornerRadius">@dimen/radius_14</item>
        <item name="chipStrokeColor">@color/fh_outline</item>
        <item name="chipStrokeWidth">@dimen/border_width</item>
    </style>

</resources>
