<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Applied only to Add/Edit fields, never to the app's global text theme. -->
    <style name="Widget.FamilyHub.FloatingCompact.Input" parent="Widget.Material3.TextInputEditText.OutlinedBox">
        <item name="android:textSize">12sp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>
    <style name="Widget.FamilyHub.FloatingCompact.DropdownInput" parent="Widget.Material3.AutoCompleteTextView.OutlinedBox">
        <item name="android:textSize">12sp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:maxLines">2</item>
        <item name="android:scrollHorizontally">false</item>
    </style>
</resources>
