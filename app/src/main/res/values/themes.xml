<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.FamilyHub" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/fh_primary</item>
        <item name="colorOnPrimary">@color/fh_on_primary</item>
        <item name="colorPrimaryContainer">@color/fh_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/fh_on_primary_container</item>
        <item name="colorSecondary">@color/fh_secondary</item>
        <item name="colorOnSecondary">@color/fh_on_secondary</item>
        <item name="colorSecondaryContainer">@color/fh_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/fh_on_secondary_container</item>
        <item name="colorTertiary">@color/fh_tertiary</item>
        <item name="colorOnTertiary">@color/fh_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/fh_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/fh_on_tertiary_container</item>
        <item name="android:colorBackground">@color/fh_background</item>
        <item name="android:windowBackground">@drawable/bg_page_three_tone</item>
        <item name="colorSurface">@color/fh_surface</item>
        <item name="colorSurfaceVariant">@color/fh_surface_variant</item>
        <item name="colorOnSurface">@color/fh_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/fh_on_surface_variant</item>
        <item name="colorOutline">@color/fh_outline</item>
        <item name="colorError">@color/fh_error</item>
        <item name="android:colorAccent">@color/fh_primary</item>
        <item name="android:fontFamily">sans</item>
        <item name="materialButtonStyle">@style/Widget.FamilyHub.Button.Primary</item>
        <item name="textInputStyle">@style/Widget.FamilyHub.TextInputLayout</item>
        <item name="editTextStyle">@style/Widget.FamilyHub.FormInputText</item>
        <item name="android:autoCompleteTextViewStyle">@style/Widget.FamilyHub.FormDropdownText</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.FamilyHub.FormDialog</item>
        <item name="android:navigationBarColor">@color/fh_background</item>
        <item name="android:statusBarColor">@color/fh_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="Theme.FamilyHub.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/fh_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_family_hub_mark</item>
        <item name="windowSplashScreenAnimationDuration">650</item>
        <item name="postSplashScreenTheme">@style/Theme.FamilyHub</item>
    </style>

    <style name="Widget.FamilyHub.BottomNavigation.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/fh_primary_container</item>
    </style>

    <style name="TextAppearance.FamilyHub.BottomNavigation.Active" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textColor">@color/fh_primary</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.FamilyHub.BottomNavigation.Inactive" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textColor">@color/fh_on_surface_variant</item>
        <item name="android:textSize">9sp</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="Widget.FamilyHub.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/fh_form_surface</item>
        <item name="boxCornerRadiusTopStart">@dimen/radius_12</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_12</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_12</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_12</item>
        <item name="boxStrokeColor">@color/form_input_stroke</item>
        <item name="boxStrokeWidth">@dimen/border_width</item>
        <item name="boxStrokeWidthFocused">1dp</item>
        <item name="hintTextAppearance">@style/TextAppearance.FamilyHub.FormHint</item>
        <item name="hintTextColor">@color/fh_on_surface_variant</item>
        <item name="startIconTint">@color/fh_form_accent</item>
        <item name="endIconTint">@color/fh_form_accent</item>
    </style>

    <style name="Widget.FamilyHub.FormInputText" parent="Widget.AppCompat.EditText">
        <item name="android:background">@null</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textColor">@color/fh_on_surface</item>
        <item name="android:textColorHint">@color/fh_on_surface_variant</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Widget.FamilyHub.FormDropdownText" parent="Widget.AppCompat.AutoCompleteTextView">
        <item name="android:background">@null</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">@color/fh_on_surface</item>
        <item name="android:textColorHint">@color/fh_on_surface_variant</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="ShapeAppearanceOverlayFamilyHubFormDialog">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_24</item>
    </style>

    <style name="ThemeOverlay.FamilyHub.FormDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:windowBackground">@drawable/bg_form_three_tone</item>
        <item name="colorPrimary">@color/fh_form_accent</item>
        <item name="colorPrimaryContainer">@color/fh_form_accent_container</item>
        <item name="colorSurface">@color/fh_form_background</item>
        <item name="colorSurfaceVariant">@color/fh_form_surface_tint</item>
        <item name="colorOutline">@color/fh_form_outline</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlayFamilyHubFormDialog</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.FamilyHub.Button.FormPrimary</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.FamilyHub.Button.FormSecondary</item>
    </style>
</resources>
