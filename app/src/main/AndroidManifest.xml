<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:name=".core.FamilyHubApplication"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_family_hub_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_family_hub_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.FamilyHub">

        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.backupfiles"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/backup_file_paths" />
        </provider>

        <service
            android:name=".location.FamilyLocationService"
            android:exported="false"
            android:foregroundServiceType="location"
            android:stopWithTask="false" />

        <service
            android:name=".feature.grocery.widget.GroceryWidgetService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <service
            android:name=".feature.grocery.overlay.GroceryOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-enabled draggable grocery quick-add and shared checklist overlay" />
        </service>

        <receiver
            android:name=".feature.grocery.widget.GroceryWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/grocery_widget_info" />
        </receiver>

        <activity
            android:name=".backup.BackupRestoreActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".feature.automation.FamilyAutomationActivity"
            android:exported="false" />
        <activity
            android:name=".feature.insights.FamilyLocationReportsActivity"
            android:exported="false" />
        <activity
            android:name=".feature.journey.FamilyJourneyMapActivity"
            android:exported="false" />
        <activity
            android:name=".feature.journey.FamilyJourneyActivity"
            android:exported="false" />
        <activity
            android:name=".feature.safety.FamilySafetyCenterActivity"
            android:exported="false" />
        <activity
            android:name=".feature.sos.FamilySosActivity"
            android:exported="false" />
        <activity
            android:name=".feature.familylive.SafePlacesActivity"
            android:exported="false" />
        <activity
            android:name=".feature.familylive.SafePlaceMapPickerActivity"
            android:exported="false" />
        <activity
            android:name=".feature.familylive.SafePlaceAlertHistoryActivity"
            android:exported="false" />
        <activity
            android:name=".feature.familylive.FamilyStreetViewActivity"
            android:exported="false" />
        <activity
            android:name=".feature.familylive.FamilyMapActivity"
            android:exported="false" />
        <activity
            android:name=".feature.familylive.FamilyMemberDetailActivity"
            android:exported="false" />

        <receiver
            android:name=".geofence.FamilyGeofenceReceiver"
            android:exported="false" />

        <activity
            android:name=".feature.familyaccount.HouseholdManagementActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".feature.familyaccount.FamilyManagementActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".feature.familyaccount.FamilySetupActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".feature.auth.AuthActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".feature.profile.ProfileSettingsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".feature.search.GlobalSearchActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".feature.diagnostics.AppDiagnosticsActivity"
            android:exported="false" />

        <activity
            android:name=".feature.help.HelpActivity"
            android:exported="false" />

        <activity
            android:name=".feature.grocery.overlay.GroceryVoiceCaptureActivity"
            android:exported="false"
            android:theme="@style/Theme.FamilyHub.VoiceCapture" />

        <activity
            android:name=".feature.main.MainActivity"
            android:exported="false" />

        <activity
            android:name=".feature.main.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.FamilyHub.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".receiver.MovementTransitionReceiver"
            android:exported="false" />

        <receiver
            android:name=".receiver.LocationSharingBootReceiver"
            android:directBootAware="false"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.USER_UNLOCKED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".core.reminders.ReminderReceiver"
            android:exported="false" />

        <receiver
            android:name=".core.planner.PlannerReceiver"
            android:exported="false" />

        <receiver
            android:name=".core.reminders.ReminderBootReceiver"
            android:directBootAware="false"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
